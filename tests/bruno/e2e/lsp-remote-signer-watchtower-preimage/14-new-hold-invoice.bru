meta {
  name: hosted tenant creates hold invoice
  type: http
  seq: 14
}

post {
  url: {{NODE2_RPC_URL}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{REMOTE_TENANT_TOKEN}}
}

body:json {
  {
    "id": "42",
    "jsonrpc": "2.0",
    "method": "new_invoice",
    "params": [
      {
        "amount": "0xf4240",
        "currency": "Fibd",
        "description": "hosted remote-signer hold invoice",
        "expiry": "0xe10",
        "allow_trampoline_routing": true,
        "payment_hash": "0x09dfb3a3fa5af1b3359b6256945af43e31be9f86f3d1b45779cebc09dc609138"
      }
    ]
  }
}

assert {
  res.body.error: isUndefined
  res.body.result.invoice_address: isDefined
  res.body.result.invoice.data.payment_hash: eq "0x09dfb3a3fa5af1b3359b6256945af43e31be9f86f3d1b45779cebc09dc609138"
}

script:post-response {
  const routeHint = res.body.result.invoice.data.attrs
    .map(attr => attr.trampoline_route_hint)
    .find(value => value !== undefined);
  if (routeHint !== bru.getEnvVar("NODE2_PUBKEY")) {
    throw new Error("hosted invoice must advertise Public T as its trampoline route hint");
  }
  bru.setVar("LSP_INCOMING_INVOICE", res.body.result.invoice_address);
  bru.setVar("LSP_INCOMING_PAYMENT_HASH", res.body.result.invoice.data.payment_hash);
  bru.setVar("LSP_INCOMING_PREIMAGE", "0x2222222222222222222222222222222222222222222222222222222222222222");
}
