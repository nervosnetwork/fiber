meta {
  name: wait hosted hold invoice received
  type: http
  seq: 16
}

post {
  url: {{NODE2_RPC_URL}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{REMOTE_TENANT_TOKEN}}
}

body:json {
  {
    "id": "42",
    "jsonrpc": "2.0",
    "method": "get_invoice",
    "params": [
      { "payment_hash": "{{LSP_INCOMING_PAYMENT_HASH}}" }
    ]
  }
}

vars:post-response {
  HOLD_RECEIVED_MAX_ITERATIONS: 60
}

script:post-response {
  if (res.body.error) throw new Error(res.body.error.message);
  const status = res.body.result.status;
  if (status === "Paid") {
    throw new Error("hold invoice settled off-chain before force-close");
  }
  const iteration = Number(bru.getVar("HOLD_RECEIVED_ITERATION") || 0);
  if (status === "Received") {
    bru.setVar("HOLD_RECEIVED_ITERATION", 0);
    return;
  }
  if (iteration + 1 < Number(bru.getVar("HOLD_RECEIVED_MAX_ITERATIONS"))) {
    bru.setVar("HOLD_RECEIVED_ITERATION", iteration + 1);
    await new Promise(r => setTimeout(r, 1000));
    bru.setNextRequest("wait hosted hold invoice received");
    return;
  }
  throw new Error(`hold invoice stayed ${status}`);
}
