meta {
  name: wait for hosted channel to close after watchtower settlement
  type: http
  seq: 23
}

post {
  url: {{NODE2_RPC_URL}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{REMOTE_TENANT_TOKEN}}
}

body:json {
  {"id":"42","jsonrpc":"2.0","method":"list_channels","params":[{"include_closed":true}]}
}

script:pre-request {
  const token = bru.getVar("REMOTE_TENANT_TOKEN") || bru.getEnvVar("REMOTE_TENANT_TOKEN");
  if (token) {
    req.setHeader("Authorization", `Bearer ${token}`);
  }
}

vars:post-response {
  REMOTE_CLOSED_MAX_ITERATIONS: 60
}

script:post-response {
  if (res.body.error) throw new Error(res.body.error.message);
  const channel = (res.body.result.channels || []).find(
    item => item.channel_id === bru.getVar("REMOTE_CHANNEL_ID")
  );
  const iteration = Number(bru.getVar("REMOTE_CLOSED_ITERATION") || 0);
  if (channel?.state?.state_name === "Closed") {
    bru.setVar("REMOTE_CLOSED_ITERATION", 0);
    return;
  }
  if (iteration + 1 < Number(bru.getVar("REMOTE_CLOSED_MAX_ITERATIONS"))) {
    bru.setVar("REMOTE_CLOSED_ITERATION", iteration + 1);
    await new Promise(r => setTimeout(r, 1000));
    bru.setNextRequest("wait for hosted channel to close after watchtower settlement");
    return;
  }
  throw new Error(`hosted channel did not close after force-close: ${JSON.stringify(channel)}`);
}
