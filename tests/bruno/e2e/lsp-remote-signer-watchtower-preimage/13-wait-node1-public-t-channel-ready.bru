meta {
  name: wait Node1 Public T channel ready
  type: http
  seq: 13
}

post {
  url: {{NODE1_RPC_URL}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {"id":"42","jsonrpc":"2.0","method":"list_channels","params":[{"pubkey":"{{NODE2_PUBKEY}}"}]}
}

vars:post-response {
  PUBLIC_T_CHANNEL_MAX_ITERATIONS: 30
}

assert {
  res.body.error: isUndefined
}

script:post-response {
  const channel = (res.body.result.channels || []).find(
    item => item.state?.state_name === "ChannelReady"
  );
  const iteration = Number(bru.getVar("PUBLIC_T_CHANNEL_ITERATION") || 0);
  const maxIterations = Number(bru.getVar("PUBLIC_T_CHANNEL_MAX_ITERATIONS"));

  if (channel) {
    bru.setVar("PUBLIC_T_CHANNEL_ID", channel.channel_id);
    bru.setVar("PUBLIC_T_CHANNEL_ITERATION", 0);
    return;
  }
  if (iteration + 1 < maxIterations) {
    bru.setVar("PUBLIC_T_CHANNEL_ITERATION", iteration + 1);
    await new Promise(r => setTimeout(r, 1000));
    bru.setNextRequest("wait Node1 Public T channel ready");
    return;
  }
  throw new Error("Node1 channel to Public T did not become ready");
}
