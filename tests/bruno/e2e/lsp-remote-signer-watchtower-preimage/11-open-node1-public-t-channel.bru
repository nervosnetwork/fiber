meta {
  name: open Node1 channel to Public T
  type: http
  seq: 11
}

post {
  url: {{NODE1_RPC_URL}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "id": "42",
    "jsonrpc": "2.0",
    "method": "open_channel",
    "params": [
      {
        "pubkey": "{{NODE2_PUBKEY}}",
        "funding_amount": "0xba43b7400",
        "public": false
      }
    ]
  }
}

assert {
  res.body.error: isUndefined
  res.body.result.temporary_channel_id: isDefined
}

script:post-response {
  await new Promise(r => setTimeout(r, 2000));
}
