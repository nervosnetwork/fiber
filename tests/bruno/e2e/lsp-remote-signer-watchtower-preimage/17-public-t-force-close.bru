meta {
  name: Public T force closes the hosted channel
  type: http
  seq: 17
}

post {
  url: {{NODE2_RPC_URL}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{LSP_OPERATOR_TOKEN}}
}

body:json {
  {"id":"42","jsonrpc":"2.0","method":"shutdown_channel","params":[{"channel_id":"placeholder","force":true}]}
}

script:pre-request {
  const body = req.getBody();
  body.params[0].channel_id = bru.getVar("REMOTE_CHANNEL_ID");
  req.setBody(body);
}

assert {
  res.body.error: isUndefined
}
