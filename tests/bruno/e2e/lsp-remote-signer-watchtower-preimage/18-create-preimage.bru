meta {
  name: tenant pushes preimage for on-chain TLC claim
  type: http
  seq: 18
}

post {
  url: {{NODE2_RPC_URL}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{REMOTE_TENANT_TOKEN}}
}

body:json {
  {
    "id": "42",
    "jsonrpc": "2.0",
    "method": "create_preimage",
    "params": [
      {
        "payment_hash": "{{LSP_INCOMING_PAYMENT_HASH}}",
        "preimage": "{{LSP_INCOMING_PREIMAGE}}"
      }
    ]
  }
}

assert {
  res.body.error: isUndefined
}
