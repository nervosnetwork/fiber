meta {
  name: check force-closed commitment output is settled
  type: http
  seq: 24
}

post {
  url: {{CKB_RPC_URL}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "id": 42,
    "jsonrpc": "2.0",
    "method": "get_live_cell",
    "params": [{"index": "0x0", "tx_hash": "{{TX_HASH}}"}, false]
  }
}

script:pre-request {
  const body = req.getBody();
  body.params[0].tx_hash = bru.getVar("TX_HASH") || bru.getEnvVar("TX_HASH");
  req.setBody(body);
}

assert {
  res.body.result.status: eq "unknown"
}
