meta {
  name: settle prefund invoice
  type: http
  seq: 5.945
}

post {
  url: {{NODE2_RPC_URL}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{LSP_OPERATOR_TOKEN}}
}

body:json {
  {"id":"42","jsonrpc":"2.0","method":"settle_invoice",
   "params":[{"payment_hash":"placeholder","payment_preimage":"placeholder"}]}
}

script:pre-request {
  const body = req.getBody();
  body.params[0].payment_hash = bru.getVar("PREFUND_PAYMENT_HASH");
  body.params[0].payment_preimage = bru.getVar("PREFUND_PREIMAGE");
  req.setBody(body);
}

assert {
  res.body.error: isUndefined
}

script:post-response {
  if (res.body.error) throw new Error(JSON.stringify(res.body.error));
  bru.setNextRequest("wait prefund payment success");
}
