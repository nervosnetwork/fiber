meta {
  name: wait payer funding broadcast
  type: http
  seq: 8.02
}

post {
  url: {{CKB_RPC_URL}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {"id":42,"jsonrpc":"2.0","method":"get_transaction","params":["placeholder"]}
}

script:pre-request {
  const body = req.getBody();
  body.params[0] = bru.getVar("CURRENT_PAYER_FUNDING_TX_HASH");
  req.setBody(body);
}

assert {
  res.body.error: isUndefined
}

script:post-response {
  if (res.body.error) throw new Error(JSON.stringify(res.body.error));
  const status = res.body.result?.tx_status?.status;
  // open_channel returns before broadcast. Mining earlier can leave the later
  // funding transaction pending forever because this fixture has no auto-miner.
  if (["pending", "proposed", "committed"].includes(status)) {
    bru.setVar("CURRENT_PAYER_BROADCAST_ITERATION", 0);
    bru.setNextRequest("generate payer channel epochs");
    return;
  }
  if (status === "rejected") {
    throw new Error(`payer funding transaction rejected: ${JSON.stringify(res.body.result.tx_status)}`);
  }
  const iteration = Number(bru.getVar("CURRENT_PAYER_BROADCAST_ITERATION") || 0);
  if (iteration + 1 < 30) {
    bru.setVar("CURRENT_PAYER_BROADCAST_ITERATION", iteration + 1);
    await new Promise(r => setTimeout(r, 1000));
    bru.setNextRequest("wait payer funding broadcast");
    return;
  }
  throw new Error(`payer funding transaction was not broadcast: ${JSON.stringify(res.body)}`);
}
