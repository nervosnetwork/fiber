meta {
  name: check current tenant channel ready
  type: http
  seq: 5.6
}

post {
  url: {{NODE2_RPC_URL}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{LSP_TENANT_TOKEN}}
}

body:json {
  {"id":"42","jsonrpc":"2.0","method":"list_channels","params":[{"pubkey":"{{NODE2_PUBKEY}}"}]}
}

assert {
  res.body.error: isUndefined
}

script:post-response {
  const channel = (res.body.result.channels || []).find(item => item.channel_id === bru.getVar("CURRENT_CHANNEL_ID"));
  const iteration = Number(bru.getVar("CURRENT_READY_ITERATION") || 0);
  if (channel?.state?.state_name === "ChannelReady") {
    bru.setVar("CURRENT_READY_ITERATION", 0);
    bru.setNextRequest("advance tenant asset");
    return;
  }
  if (iteration + 1 < 30) {
    bru.setVar("CURRENT_READY_ITERATION", iteration + 1);
    await new Promise(r => setTimeout(r, 1000));
    bru.setNextRequest("check current tenant channel ready");
    return;
  }
  throw new Error(`hosted channel did not become ready: ${JSON.stringify(channel)}`);
}
