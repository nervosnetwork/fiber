meta {
  name: open payer SIMPLE_UDT channel
  type: http
  seq: 9
}

post {
  url: {{NODE1_RPC_URL}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "id":"42","jsonrpc":"2.0","method":"open_channel",
    "params":[{"pubkey":"{{NODE2_PUBKEY}}","funding_amount":"0x2710","public":false,
      "funding_udt_type_script":{"code_hash":"{{UDT_CODE_HASH}}","hash_type":"data2","args":"{{UDT_SCRIPT_ARGS}}"}}]
  }
}

assert {
  res.body.error: isUndefined
  res.body.result.temporary_channel_id: isDefined
}

script:post-response {
  bru.setVar("CURRENT_PAYER_ASSET", "simple");
  bru.setVar("CURRENT_PAYER_UDT_SCRIPT", ({code_hash: bru.getEnvVar("UDT_CODE_HASH"), hash_type: "data2", args: bru.getEnvVar("UDT_SCRIPT_ARGS")}));
  bru.setNextRequest("generate payer channel epochs");
}
