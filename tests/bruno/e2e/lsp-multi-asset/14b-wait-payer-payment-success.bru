meta {
  name: wait payer payment success
  type: http
  seq: 14.1
}

post {
  url: {{NODE1_RPC_URL}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {"id":"42","jsonrpc":"2.0","method":"get_payment","params":[{"payment_hash":"placeholder"}]}
}

script:pre-request {
  const body = req.getBody();
  body.params[0].payment_hash = bru.getVar("CURRENT_PAYMENT_HASH");
  req.setBody(body);
}

assert {
  res.body.error: isUndefined
}

script:post-response {
  const payment = res.body.result;
  const iteration = Number(bru.getVar("CURRENT_PAYER_PAYMENT_ITERATION") || 0);
  if (payment.status === "Success") {
    bru.setVar("CURRENT_PAYER_PAYMENT_ITERATION", 0);
    bru.setNextRequest("wait hosted invoice paid");
    return;
  }
  if (payment.status === "Failed") {
    throw new Error(`payer failed: ${payment.failed_error}`);
  }
  if (iteration + 1 < 30) {
    bru.setVar("CURRENT_PAYER_PAYMENT_ITERATION", iteration + 1);
    await new Promise(r => setTimeout(r, 1000));
    bru.setNextRequest("wait payer payment success");
    return;
  }
  throw new Error(`payer stayed ${payment.status}`);
}
