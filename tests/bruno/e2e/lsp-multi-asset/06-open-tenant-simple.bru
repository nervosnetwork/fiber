meta {
  name: open tenant SIMPLE_UDT channel
  type: http
  seq: 6
}

post {
  url: {{LSP_SDK_AGENT_URL}}/open-channel
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "params":{
      "pubkey":"{{NODE2_PUBKEY}}","public":false,
      "funding_amount":"0x2710","commitment_fee_rate":"0x3e8","commitment_delay_epoch":"0x10000000001",
      "shutdown_script":{},"funding_lock_script":{},"external_channel_signer":{},
      "funding_udt_type_script":{"code_hash":"{{UDT_CODE_HASH}}","hash_type":"data2","args":"{{UDT_SCRIPT_ARGS}}"}
    }
  }
}

script:pre-request {
  const body = req.getBody();
  body.params.shutdown_script = bru.getVar("REMOTE_FUNDING_SCRIPT");
  body.params.funding_lock_script = bru.getVar("REMOTE_FUNDING_SCRIPT");
  body.params.external_channel_signer = bru.getVar("REMOTE_OPEN_MATERIAL");
  req.setBody(body);
}

assert {
  res.body.error: isUndefined
  res.body.result.channel_id: isDefined
  res.body.result.unsigned_funding_tx: isDefined
}

script:post-response {
  if (res.body.error) throw new Error(JSON.stringify(res.body.error));
  bru.setVar("CURRENT_CHANNEL_ID", res.body.result.channel_id);
  bru.setVar("CURRENT_UNSIGNED_TX", res.body.result.unsigned_funding_tx);
  bru.setVar("CURRENT_ASSET", "simple");
  bru.setNextRequest("sign current tenant funding");
}
