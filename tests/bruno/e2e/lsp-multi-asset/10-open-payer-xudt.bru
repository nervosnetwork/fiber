meta {
  name: open payer XUDT channel
  type: http
  seq: 10
}

post {
  url: {{NODE1_RPC_URL}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "id":"42","jsonrpc":"2.0","method":"open_channel",
    "params":[{"pubkey":"{{NODE2_PUBKEY}}","funding_amount":"0x2710","public":false,
      "funding_udt_type_script":{"code_hash":"{{XUDT_CODE_HASH}}","hash_type":"data2","args":"{{XUDT_SCRIPT_ARGS}}"}}]
  }
}

assert {
  res.body.error: isUndefined
  res.body.result.temporary_channel_id: isDefined
}

script:post-response {
  if (res.body.error) throw new Error(JSON.stringify(res.body.error));
  bru.setVar("CURRENT_PAYER_ASSET", "xudt");
  bru.setVar("CURRENT_PAYER_UDT_SCRIPT", ({code_hash: bru.getEnvVar("XUDT_CODE_HASH"), hash_type: "data2", args: bru.getEnvVar("XUDT_SCRIPT_ARGS")}));
  bru.setVar("CURRENT_PAYER_FUNDING_ITERATION", 0);
  bru.setVar("CURRENT_PAYER_BROADCAST_ITERATION", 0);
  bru.setNextRequest("wait payer funding transaction");
}
