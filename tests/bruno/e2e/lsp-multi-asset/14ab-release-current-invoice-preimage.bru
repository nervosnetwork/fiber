meta {
  name: release current hosted invoice preimage
  type: http
  seq: 14.02
}

post {
  url: {{LSP_SDK_AGENT_URL}}/authorize
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {"type":"ReleasePreimage","channel_id":"placeholder","payment_hash":"placeholder","preimage":"placeholder","target":"Invoice"}
}

script:pre-request {
  const body = req.getBody();
  body.channel_id = bru.getVar("CURRENT_INVOICE_CHANNEL_ID");
  body.payment_hash = bru.getVar("CURRENT_PAYMENT_HASH");
  body.preimage = bru.getVar("CURRENT_INVOICE_PREIMAGE");
  req.setBody(body);
}

assert {
  res.status: eq 200
  res.body.result.authorized: eq true
}

script:post-response {
  if (res.body.result?.authorized !== true) {
    throw new Error(`preimage release failed: ${JSON.stringify(res.body)}`);
  }
  bru.setNextRequest("wait payer payment success");
}
