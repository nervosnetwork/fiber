meta {
  name: send prefund payment
  type: http
  seq: 5.92
}

post {
  url: {{NODE2_RPC_URL}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{LSP_TENANT_TOKEN}}
}

body:json {
  {"id":"42","jsonrpc":"2.0","method":"send_payment",
   "params":[{"invoice":"placeholder","max_fee_amount":"0x0","tlc_expiry_limit":"0x240c8400"}]}
}

script:pre-request {
  const body = req.getBody();
  body.params[0].invoice = bru.getVar("PREFUND_INVOICE");
  req.setBody(body);
}

assert {
  res.body.error: isUndefined
  res.body.result.payment_hash: eq "{{PREFUND_PAYMENT_HASH}}"
}

script:post-response {
  if (res.body.error) throw new Error(JSON.stringify(res.body.error));
  bru.setNextRequest("wait prefund invoice received");
}
