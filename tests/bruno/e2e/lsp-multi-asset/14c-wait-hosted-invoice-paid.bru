meta {
  name: wait hosted invoice paid
  type: http
  seq: 14.2
}

post {
  url: {{NODE2_RPC_URL}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{LSP_TENANT_TOKEN}}
}

body:json {
  {"id":"42","jsonrpc":"2.0","method":"get_invoice","params":[{"payment_hash":"placeholder"}]}
}

script:pre-request {
  const body = req.getBody();
  body.params[0].payment_hash = bru.getVar("CURRENT_PAYMENT_HASH");
  req.setBody(body);
}

assert {
  res.body.error: isUndefined
}

script:post-response {
  const status = res.body.result.status;
  const iteration = Number(bru.getVar("CURRENT_INVOICE_ITERATION") || 0);
  if (status === "Paid") {
    bru.setVar("CURRENT_INVOICE_ITERATION", 0);
    bru.setNextRequest("advance invoice asset");
    return;
  }
  if (iteration + 1 < 30) {
    bru.setVar("CURRENT_INVOICE_ITERATION", iteration + 1);
    await new Promise(r => setTimeout(r, 1000));
    bru.setNextRequest("wait hosted invoice paid");
    return;
  }
  throw new Error(`hosted invoice stayed ${status}`);
}
