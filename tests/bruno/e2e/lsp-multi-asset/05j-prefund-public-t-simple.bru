meta {
  name: prefund public T SIMPLE_UDT
  type: http
  seq: 5.9
}

post {
  url: {{NODE2_RPC_URL}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{LSP_OPERATOR_TOKEN}}
}

body:json {
  {
    "id":"42","jsonrpc":"2.0","method":"new_invoice",
    "params":[{
      "amount":"0x1388",
      "currency":"Fibd",
      "expiry":"0xe10",
      "payment_hash":"0x934544ad6e8c045369048116a4211f8da8d36802967aa20320eb4044b3b6273f",
      "udt_type_script":{"code_hash":"{{UDT_CODE_HASH}}","hash_type":"data2","args":"{{UDT_SCRIPT_ARGS}}"},
      "description":"prefund Public T SIMPLE_UDT liquidity"
    }]
  }
}

assert {
  res.body.error: isUndefined
  res.body.result.invoice_address: isDefined
}

script:post-response {
  if (res.body.error) throw new Error(JSON.stringify(res.body.error));
  bru.setVar("PREFUND_ASSET", "simple");
  bru.setVar("PREFUND_CHANNEL_ID", bru.getVar("HOSTED_SIMPLE_CHANNEL_ID"));
  bru.setVar("PREFUND_INVOICE", res.body.result.invoice_address);
  bru.setVar("PREFUND_PAYMENT_HASH", res.body.result.invoice.data.payment_hash);
  bru.setVar("PREFUND_PREIMAGE", "0x4444444444444444444444444444444444444444444444444444444444444444");
  bru.setVar("PREFUND_ITERATION", 0);
  bru.setVar("PREFUND_INVOICE_ITERATION", 0);
  bru.setNextRequest("authorize prefund payment");
}
