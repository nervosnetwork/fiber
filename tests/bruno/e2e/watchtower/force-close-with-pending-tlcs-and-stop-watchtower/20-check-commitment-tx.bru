meta {
  name: check submitted commitment tx should be settled
  type: http
  seq: 20
}

post {
  url: {{CKB_RPC_URL}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "id": 42,
    "jsonrpc": "2.0",
    "method": "get_live_cell",
    "params": [
      {
        "index": "0x0",
        "tx_hash": "{{TX_HASH}}"
      },
      false
    ]
  }
}

assert {
  res.body.error: isUndefined
  res.body.result.status: isDefined
}

script:post-response {
  if (res.body.result.status === "unknown") {
    return;
  }
  if (Date.now() < Number(bru.getVar("SETTLEMENT_DEADLINE"))) {
    bru.setNextRequest("generate a few blocks for final settlement tx1 to be committed");
    return;
  }
  throw new Error(`commitment output was not settled: ${JSON.stringify(res.body.result)}`);
}
