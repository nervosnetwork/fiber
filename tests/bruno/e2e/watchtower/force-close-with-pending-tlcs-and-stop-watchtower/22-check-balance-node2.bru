meta {
  name: check balance, the difference should be the open channel amount (0x826299e00) + fee (it may vary, max 5000)
  type: http
  seq: 22
}

post {
  url: {{CKB_RPC_URL}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "id": 42,
    "jsonrpc": "2.0",
    "method": "get_cells_capacity",
    "params": [
      {
        "script_type": "lock"
      }
    ]
  }
}

script:pre-request {
  let script = bru.getVar("NODE2_FUNDING_SCRIPT");
  let body = req.getBody();
  body.params[0].script = script;
  req.setBody(body);
}

assert {
  res.body.error: isUndefined
  res.body.result.capacity: isDefined
}

script:post-response {
  const delta = BigInt(bru.getVar("NODE2_BALANCE")) - BigInt(res.body.result.capacity);
  // With its watch stopped, Node2 has not reclaimed its channel funding.
  // This lower bound also detects an accidentally running second watchtower.
  if (delta >= BigInt(35000000000) && delta < BigInt(35000005000)) {
    bru.setVar("SETTLEMENT_DEADLINE", null);
    return;
  }
  if (Date.now() < Number(bru.getVar("SETTLEMENT_DEADLINE"))) {
    console.log(`waiting for Node2 final balance, balance delta=${delta}`);
    bru.setNextRequest("generate a few blocks for final settlement tx1 to be committed");
    return;
  }
  throw new Error(`Node2 balance delta=${delta} is outside expected range [35000000000, 35000005000)`);
}
