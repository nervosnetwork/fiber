meta {
  name: generate a few blocks for final settlement tx1 to be committed
  type: http
  seq: 19
}

post {
  url: {{CKB_RPC_URL}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "id": 42,
    "jsonrpc": "2.0",
    "method": "generate_epochs",
    "params": ["0x1"]
  }
}

assert {
  res.status: eq 200
  res.body.error: isUndefined
}

script:pre-request {
  // Share one bounded wait across the commitment and both balance checks.
  // Spending the original commitment output is not enough: later settlement
  // transactions must also be mined before wallet balances are final.
  if (!bru.getVar("SETTLEMENT_DEADLINE")) {
    bru.setVar("SETTLEMENT_DEADLINE", Date.now() + 120000);
  }
}

script:post-response {
  await new Promise(r => setTimeout(r, 1000));
}
