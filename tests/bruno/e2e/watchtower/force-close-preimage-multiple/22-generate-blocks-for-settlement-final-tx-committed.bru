meta {
  name: generate a few blocks for final settlement tx committed
  type: http
  seq: 22
}

post {
  url: {{CKB_RPC_URL}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "id": 42,
    "jsonrpc": "2.0",
    "method": "generate_epochs",
    "params": ["0xa"]
  }
}

assert {
  res.status: eq 200
}

script:pre-request {
  // The first pass advances the settlement timelocks. Subsequent passes mine
  // for proposal/commitment while request 23 polls the actual returned capacity.
  if (bru.getVar("settlement_poll_iteration") > 0) {
    let body = req.getBody();
    body.params = ["0x1"];
    req.setBody(body);
  }
}
