meta {
  name: Node1 detects remote force-close
  type: http
  seq: 26
}

post {
  url: {{NODE1_RPC_URL}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "id": "42",
    "jsonrpc": "2.0",
    "method": "check_channel_shutdown",
    "params": [
      {
        "channel_id": "{{FORCE_CLOSED_CHANNEL}}"
      }
    ]
  }
}

assert {
  res.body.error: isUndefined
}

script:post-response {
  // Wait for the asynchronous chain lookup and channel state transition.
  await new Promise(r => setTimeout(r, 2000));
}
