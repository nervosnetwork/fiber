meta {
  name: Node3 creates MPP hold invoice
  type: http
  seq: 15
}

post {
  url: {{NODE3_RPC_URL}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "id": "42",
    "jsonrpc": "2.0",
    "method": "new_invoice",
    "params": [
      {
        "amount": "0x174e6cc900",
        "currency": "Fibd",
        "description": "MPP force-close one A-B shard",
        "expiry": "0xe10",
        "final_expiry_delta": "0xdffa0",
        "payment_hash": "0x266cec97cbede2cfbce73666f08deed9560bdf7841a7a5a51b3a3f09da249e21",
        "allow_mpp": true,
        "allow_trampoline_routing": true
      }
    ]
  }
}

assert {
  res.body.error: isUndefined
  res.body.result.invoice_address: isDefined
}

script:post-response {
  const paymentHash = res.body.result.invoice.data.payment_hash;
  if (paymentHash !== "0x266cec97cbede2cfbce73666f08deed9560bdf7841a7a5a51b3a3f09da249e21") {
    throw new Error(`unexpected payment hash ${paymentHash}`);
  }
  bru.setVar("MPP_INVOICE", res.body.result.invoice_address);
  bru.setVar("PAYMENT_HASH", paymentHash);
}
