meta {
  name: wait MPP invoice Paid
  type: http
  seq: 30
}

post {
  url: {{NODE3_RPC_URL}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "id": "42",
    "jsonrpc": "2.0",
    "method": "get_invoice",
    "params": [
      {"payment_hash": "{{PAYMENT_HASH}}"}
    ]
  }
}

vars:post-response {
  INVOICE_PAID_MAX_ITERATIONS: 120
}

assert {
  res.body.error: isUndefined
}

script:post-response {
  const status = res.body.result.status;
  const iteration = Number(bru.getVar("INVOICE_PAID_ITERATION") || 0);
  const maxIterations = Number(bru.getVar("INVOICE_PAID_MAX_ITERATIONS"));

  if (status === "Paid") {
    bru.setVar("INVOICE_PAID_ITERATION", 0);
    return;
  }
  if (iteration + 1 < maxIterations) {
    bru.setVar("INVOICE_PAID_ITERATION", iteration + 1);
    await new Promise(r => setTimeout(r, 2000));
    bru.setNextRequest("wait MPP invoice Paid");
    return;
  }
  throw new Error(`invoice did not reach Paid, last_status=${String(status)}`);
}
