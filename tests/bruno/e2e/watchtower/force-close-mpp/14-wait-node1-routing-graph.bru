meta {
  name: wait Node1 routing graph
  type: http
  seq: 14
}

post {
  url: {{NODE1_RPC_URL}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "id": "42",
    "jsonrpc": "2.0",
    "method": "graph_channels",
    "params": [
      {}
    ]
  }
}

vars:post-response {
  GRAPH_MAX_ITERATIONS: 30
}

assert {
  res.body.error: isUndefined
}

script:post-response {
  const channels = res.body.result.channels;
  const iteration = Number(bru.getVar("GRAPH_ITERATION") || 0);
  const maxIterations = Number(bru.getVar("GRAPH_MAX_ITERATIONS"));

  if (channels.length >= 3) {
    bru.setVar("GRAPH_ITERATION", 0);
    return;
  }
  if (iteration + 1 < maxIterations) {
    bru.setVar("GRAPH_ITERATION", iteration + 1);
    await new Promise(r => setTimeout(r, 1000));
    bru.setNextRequest("wait Node1 routing graph");
    return;
  }
  throw new Error(`Node1 graph has ${channels.length} channels, expected at least 3`);
}
