meta {
  name: verify payment awaits on-chain reconciliation
  type: http
  seq: 24
}

post {
  url: {{NODE1_RPC_URL}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "id": "42",
    "jsonrpc": "2.0",
    "method": "get_payment",
    "params": [
      {"payment_hash": "{{PAYMENT_HASH}}"}
    ]
  }
}

assert {
  res.body.error: isUndefined
  res.body.result.status: eq Inflight
}
