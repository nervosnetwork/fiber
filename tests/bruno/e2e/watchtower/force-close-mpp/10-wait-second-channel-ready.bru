meta {
  name: wait second Node1-Node2 channel ready
  type: http
  seq: 10
}

post {
  url: {{NODE1_RPC_URL}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "id": "42",
    "jsonrpc": "2.0",
    "method": "list_channels",
    "params": [
      {"pubkey": "{{NODE2_PUBKEY}}"}
    ]
  }
}

vars:post-response {
  CHANNEL_READY_MAX_ITERATIONS: 30
}

assert {
  res.body.error: isUndefined
}

script:post-response {
  const channel = res.body.result.channels.find(
    channel => channel.channel_id === bru.getVar("AB_CHANNEL_2")
  );
  const iteration = Number(bru.getVar("AB2_READY_ITERATION") || 0);
  const maxIterations = Number(bru.getVar("CHANNEL_READY_MAX_ITERATIONS"));

  if (channel?.state?.state_name === "ChannelReady") {
    bru.setVar("AB2_READY_ITERATION", 0);
    return;
  }
  if (iteration + 1 < maxIterations) {
    bru.setVar("AB2_READY_ITERATION", iteration + 1);
    await new Promise(r => setTimeout(r, 1000));
    bru.setNextRequest("wait second Node1-Node2 channel ready");
    return;
  }
  throw new Error(
    `second channel not ready, state=${String(channel?.state?.state_name)}`
  );
}
