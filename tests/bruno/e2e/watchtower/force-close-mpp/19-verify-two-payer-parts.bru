meta {
  name: verify two payer MPP parts
  type: http
  seq: 19
}

post {
  url: {{NODE1_RPC_URL}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "id": "42",
    "jsonrpc": "2.0",
    "method": "list_channels",
    "params": [
      {"pubkey": "{{NODE2_PUBKEY}}"}
    ]
  }
}

assert {
  res.body.error: isUndefined
}

script:post-response {
  const paymentHash = bru.getVar("PAYMENT_HASH");
  const channelsWithPart = res.body.result.channels.filter(channel =>
    channel.pending_tlcs.some(tlc => tlc.payment_hash === paymentHash)
  );

  if (channelsWithPart.length !== 2) {
    throw new Error(`expected MPP parts on two A-B channels, got ${channelsWithPart.length}`);
  }
  for (const channel of channelsWithPart) {
    const matching = channel.pending_tlcs.filter(tlc => tlc.payment_hash === paymentHash);
    if (matching.length !== 1) {
      throw new Error(`expected one MPP part in ${channel.channel_id}, got ${matching.length}`);
    }
  }

  bru.setVar("FORCE_CLOSED_CHANNEL", channelsWithPart[0].channel_id);
  bru.setVar("OFFCHAIN_CHANNEL", channelsWithPart[1].channel_id);
}
