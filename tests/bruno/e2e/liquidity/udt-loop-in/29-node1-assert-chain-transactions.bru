meta {
  name: node1 assert liquidity chain transactions
  type: http
  seq: 29
}

post {
  url: {{NODE1_RPC_URL}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "id": "42",
    "jsonrpc": "2.0",
    "method": "list_liquidity_chain_transactions",
    "params": [
      {
        "swap_id": "{{QUOTE_ID}}"
      }
    ]
  }
}

assert {
  res.body.error: isUndefined
}

script:post-response {
  const { decodeOutpoint } = require(process.cwd() + "/scripts/molecule-script");

  const transactions = res.body.result.transactions || [];
  const lock = transactions.find((tx) => tx.role === "loop_in_lock");
  if (!lock) {
    throw new Error(`client must record the loop in lock transaction: ${JSON.stringify(transactions)}`);
  }
  if (lock.status !== "confirmed") {
    throw new Error(`client loop in lock record must be confirmed, got: ${lock.status}`);
  }
  if (lock.tx_hash !== bru.getVar("LOCK_TX_HASH")) {
    throw new Error(`client lock tx_hash mismatch: ${lock.tx_hash}`);
  }
  const outpoint = decodeOutpoint(lock.outpoint);
  if (outpoint.txHash !== bru.getVar("LOCK_TX_HASH")) {
    throw new Error(`client lock outpoint tx_hash mismatch: ${lock.outpoint}`);
  }
  if (BigInt(outpoint.index) !== BigInt(bru.getVar("LOCK_INDEX"))) {
    throw new Error(`client lock outpoint index mismatch: ${lock.outpoint}`);
  }

  // The client neither claims (the provider claims the lock after its payment
  // settles) nor refunds (the swap succeeded) for a Loop In swap.
  const claim = transactions.find((tx) => tx.role === "claim");
  if (claim) {
    throw new Error(`client must not record a claim transaction for loop in: ${JSON.stringify(claim)}`);
  }
  const refund = transactions.find((tx) => tx.role === "refund");
  if (refund) {
    throw new Error(`successful loop in must not record a refund: ${JSON.stringify(refund)}`);
  }
}
