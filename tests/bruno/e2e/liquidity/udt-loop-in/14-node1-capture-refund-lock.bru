meta {
  name: node1 capture refund lock script
  type: http
  seq: 14
}

post {
  url: {{NODE1_RPC_URL}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "id": "42",
    "jsonrpc": "2.0",
    "method": "node_info",
    "params": []
  }
}

assert {
  res.body.error: isUndefined
}

script:post-response {
  const { encodeMoleculeScript } = require(process.cwd() + "/scripts/molecule-script");

  // The client refund lock is the destination of the on-chain refund path of
  // the loop-in lock cell; the suite uses node1's own default funding lock so
  // the refund lands in the client wallet.
  const script = res.body.result.default_funding_lock_script;
  if (!script || typeof script.code_hash !== "string" || script.code_hash.length !== 66) {
    throw new Error(`node_info must expose a default_funding_lock_script: ${JSON.stringify(res.body.result)}`);
  }
  if (typeof script.args !== "string" || !script.args.startsWith("0x")) {
    throw new Error(`default funding lock args must be hex: ${JSON.stringify(script)}`);
  }

  const refundLock = encodeMoleculeScript({
    codeHash: script.code_hash,
    hashType: script.hash_type,
    args: script.args,
  });
  bru.setVar("REFUND_LOCK", refundLock);
  console.log("client refund lock:", refundLock);
}
