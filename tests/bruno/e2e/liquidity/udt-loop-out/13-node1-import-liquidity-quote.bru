meta {
  name: node1 import liquidity quote
  type: http
  seq: 13
}

post {
  url: {{NODE1_RPC_URL}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "id": "42",
    "jsonrpc": "2.0",
    "method": "import_liquidity_quote",
    "params": [
      {
        "quote": {{QUOTE_ENVELOPE_JSON}},
        "max_provider_fee": "{{MAX_PROVIDER_FEE_HEX}}",
        "max_routing_fee": "{{MAX_ROUTING_FEE_HEX}}"
      }
    ]
  }
}

assert {
  res.body.error: isUndefined
}

script:post-response {
  const expectedScript = JSON.parse(bru.getEnvVar("SIMPLE_UDT_TYPE_SCRIPT"));

  const envelope = res.body.result;
  if (!envelope || envelope.quote_id !== bru.getVar("QUOTE_ID")) {
    throw new Error(`import_liquidity_quote must echo quote_id ${bru.getVar("QUOTE_ID")}: ${JSON.stringify(res.body)}`);
  }
  if (envelope.asset.kind !== "udt") {
    throw new Error(`imported asset kind must be udt: ${envelope.asset.kind}`);
  }
  const importedScript = envelope.asset.udt_type_script;
  if (!importedScript
    || importedScript.code_hash !== expectedScript.code_hash
    || importedScript.hash_type !== expectedScript.hash_type
    || importedScript.args !== expectedScript.args) {
    throw new Error(`imported asset must preserve the simple UDT type script: ${JSON.stringify(importedScript)}`);
  }
  if (envelope.claimant_lock !== bru.getVar("CLAIMANT_LOCK")) {
    throw new Error(`imported claimant_lock must be preserved: ${envelope.claimant_lock}`);
  }
  if (envelope.refund_lock !== bru.getVar("QUOTE_REFUND_LOCK")) {
    throw new Error(`imported refund_lock must be preserved: ${envelope.refund_lock}`);
  }
  if (envelope.amount !== bru.getVar("QUOTE_AMOUNT") || envelope.provider_fee !== "0x" + (BigInt(bru.getVar("QUOTE_PRINCIPAL")) - BigInt(bru.getVar("QUOTE_AMOUNT"))).toString(16)) {
    throw new Error(`imported amounts must be preserved: ${JSON.stringify(envelope)}`);
  }
}
