meta {
  name: node1 assert liquidity chain transactions
  type: http
  seq: 19
}

post {
  url: {{NODE1_RPC_URL}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "id": "42",
    "jsonrpc": "2.0",
    "method": "list_liquidity_chain_transactions",
    "params": [
      {
        "swap_id": "{{QUOTE_ID}}"
      }
    ]
  }
}

assert {
  res.body.error: isUndefined
}

script:post-response {
  const { decodeOutpoint } = require(process.cwd() + "/scripts/molecule-script");

  const transactions = res.body.result.transactions || [];
  const payout = transactions.find((tx) => tx.role === "payout");
  if (!payout) {
    throw new Error(`client must record the payout transaction: ${JSON.stringify(transactions)}`);
  }
  if (payout.status !== "confirmed") {
    throw new Error(`client payout record must be confirmed, got: ${payout.status}`);
  }
  if (payout.tx_hash !== bru.getVar("PAYOUT_TX_HASH")) {
    throw new Error(`client payout tx_hash mismatch: ${payout.tx_hash}`);
  }
  const payoutOutpoint = decodeOutpoint(payout.outpoint);
  if (payoutOutpoint.txHash !== bru.getVar("PAYOUT_TX_HASH")) {
    throw new Error(`client payout outpoint tx_hash mismatch: ${payout.outpoint}`);
  }
  if (BigInt(payoutOutpoint.index) !== BigInt(bru.getVar("PAYOUT_INDEX"))) {
    throw new Error(`client payout outpoint index mismatch: ${payout.outpoint}`);
  }

  // This suite covers the deterministic provider-funded prefix of the UDT
  // Loop Out swap (see README): the client channel payment cannot route
  // through a UDT channel yet, so the swap never reaches the settlement that
  // reveals the preimage. No claim and no refund can exist at this point.
  const claim = transactions.find((tx) => tx.role === "claim");
  if (claim) {
    throw new Error(`udt loop out prefix must not record a claim transaction: ${JSON.stringify(claim)}`);
  }
  const refund = transactions.find((tx) => tx.role === "refund");
  if (refund) {
    throw new Error(`udt loop out prefix must not record a refund: ${JSON.stringify(refund)}`);
  }
}
