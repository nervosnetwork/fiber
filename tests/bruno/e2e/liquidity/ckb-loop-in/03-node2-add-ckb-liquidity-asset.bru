meta {
  name: node2 add ckb liquidity asset
  type: http
  seq: 3
}

post {
  url: {{NODE2_RPC_URL}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "id": "42",
    "jsonrpc": "2.0",
    "method": "add_liquidity_asset",
    "params": [
      {
        "asset": {
          "asset_id": "{{LIQUIDITY_CKB_ASSET_ID}}",
          "kind": "ckb",
          "udt_type_script": null,
          "min_amount": "0x1",
          "max_amount": "0xf4240",
          "available_capacity": "0xf4240",
          "base_fee": "0x1",
          "proportional_fee_ppm": "0x0",
          "enabled": true
        }
      }
    ]
  }
}

script:post-response {
  if (res.body.error) {
    // Re-runs against an already-initialized provider must not fail: the
    // registry entry is immutable via add, so "already exists" is accepted.
    // Request 04 relaxes the loop-in sizing limits via update_liquidity_asset.
    if (!String(res.body.error.message).includes("already exists")) {
      throw new Error(`add_liquidity_asset failed: ${res.body.error.message}`);
    }
    console.log("ckb liquidity asset already registered (idempotent re-run)");
    return;
  }

  const asset = res.body.result;
  const expectedAssetId = bru.getEnvVar("LIQUIDITY_CKB_ASSET_ID");
  if (asset.asset_id !== expectedAssetId) {
    throw new Error(`asset_id must be the chain asset id ${expectedAssetId}, got: ${asset.asset_id}`);
  }
  if (asset.kind !== "ckb") {
    throw new Error(`asset kind must be ckb, got: ${asset.kind}`);
  }
  if (asset.udt_type_script !== null) {
    throw new Error(`ckb asset must not carry a udt_type_script, got: ${JSON.stringify(asset.udt_type_script)}`);
  }
  if (asset.enabled !== true) {
    throw new Error("ckb asset must be enabled");
  }
}
