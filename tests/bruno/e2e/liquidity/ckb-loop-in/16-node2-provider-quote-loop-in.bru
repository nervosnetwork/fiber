meta {
  name: node2 provider quote loop in
  type: http
  seq: 16
}

post {
  url: {{NODE2_RPC_URL}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "id": "42",
    "jsonrpc": "2.0",
    "method": "quote_loop_in",
    "params": [
      {
        "provider": "{{NODE2_PUBKEY}}",
        "asset_id": "{{LIQUIDITY_CKB_ASSET_ID}}",
        "amount": "{{SWAP_AMOUNT_HEX}}",
        "client_invoice": "{{CLIENT_INVOICE}}",
        "refund_lock": "{{REFUND_LOCK}}",
        "max_provider_fee": "{{MAX_PROVIDER_FEE_HEX}}",
        "max_routing_fee": "{{MAX_ROUTING_FEE_HEX}}",
        "expires_after_seconds": "0xe10"
      }
    ]
  }
}

assert {
  res.body.error: isUndefined
}

script:post-response {
  // quote_loop_in is the provider-side quote endpoint for Loop In (it
  // requires provider mode); there is no separate provider_quote_loop_in RPC.
  const envelope = res.body.result;
  if (!envelope || !envelope.quote_id) {
    throw new Error(`quote_loop_in returned no envelope: ${JSON.stringify(res.body)}`);
  }

  if (envelope.swap_kind !== "loop_in") {
    throw new Error(`swap_kind must be loop_in, got: ${envelope.swap_kind}`);
  }
  if (envelope.provider_pubkey !== bru.getEnvVar("NODE2_PUBKEY")) {
    throw new Error(`quote provider_pubkey must be the provider node2 pubkey: ${envelope.provider_pubkey}`);
  }
  if (envelope.asset.asset_id !== bru.getEnvVar("LIQUIDITY_CKB_ASSET_ID") || envelope.asset.kind !== "ckb") {
    throw new Error(`quoted asset mismatch: ${JSON.stringify(envelope.asset)}`);
  }
  if (envelope.amount !== bru.getVar("SWAP_AMOUNT_HEX")) {
    throw new Error(`quote amount must be the requested ${bru.getVar("SWAP_AMOUNT_HEX")}, got: ${envelope.amount}`);
  }
  // Provider fee is derived from the registry response captured in request 05:
  // base_fee + amount * proportional_fee_ppm / 1_000_000.
  const expectedProviderFee =
    BigInt(bru.getVar("REGISTRY_BASE_FEE"))
    + (BigInt(bru.getVar("SWAP_AMOUNT_HEX")) * BigInt(bru.getVar("REGISTRY_FEE_PPM"))) / 1000000n;
  if (envelope.provider_fee !== "0x" + expectedProviderFee.toString(16)) {
    throw new Error(`provider_fee must be the registry-derived fee 0x${expectedProviderFee.toString(16)}, got: ${envelope.provider_fee}`);
  }
  // The provider echoes the client-requested routing fee cap unchanged.
  if (envelope.routing_fee_limit !== bru.getVar("MAX_ROUTING_FEE_HEX")) {
    throw new Error(`routing_fee_limit must be the requested cap ${bru.getVar("MAX_ROUTING_FEE_HEX")}, got: ${envelope.routing_fee_limit}`);
  }
  // Provider quote constants (liquidity actor): onchain fee estimate 1000.
  if (envelope.onchain_fee_estimate_ckb !== "0x3e8") {
    throw new Error(`unexpected on-chain fee estimate: ${envelope.onchain_fee_estimate_ckb}`);
  }
  // For Loop In the lock cell capacity equals the gross on-chain amount
  // (amount + provider fee); the channel payment itself moves only the amount.
  const gross = BigInt(bru.getVar("SWAP_AMOUNT_HEX")) + expectedProviderFee;
  if (envelope.capacity_requirement_ckb !== "0x" + gross.toString(16)) {
    throw new Error(`capacity_requirement_ckb must equal the gross on-chain amount 0x${gross.toString(16)}, got: ${envelope.capacity_requirement_ckb}`);
  }
  // The payment hash comes from the client invoice.
  if (envelope.payment_hash !== bru.getVar("PAYMENT_HASH")) {
    throw new Error(`quote payment_hash must be the client invoice payment hash: ${envelope.payment_hash}`);
  }
  // For Loop In the payout deadline is the quote expiry itself (Loop Out adds
  // a 10 second grace period).
  if (BigInt(envelope.payout_deadline) !== BigInt(envelope.expires_at)) {
    throw new Error(`payout_deadline must equal expires_at for loop in: ${envelope.payout_deadline} vs ${envelope.expires_at}`);
  }
  const expiresAt = BigInt(envelope.expires_at);
  const nowMs = BigInt(Date.now());
  if (expiresAt <= nowMs) {
    throw new Error(`quote must not be expired: expires_at=${envelope.expires_at}`);
  }
  // refund_after_lock_time is an absolute CKB `since` timestamp covering the
  // quote expiry, rounded up to whole seconds in the 56-bit value field.
  const since = BigInt(envelope.refund_after_lock_time);
  const seconds = since & 0x00ffffffffffffffn;
  if (since === seconds) {
    throw new Error(`refund_after_lock_time must carry since flag bits: ${envelope.refund_after_lock_time}`);
  }
  if (seconds * 1000n < expiresAt || seconds * 1000n >= expiresAt + 1000n) {
    throw new Error(`refund since timestamp does not cover the quote expiry: ${envelope.refund_after_lock_time}`);
  }
  // The provider claims the lock cell into its own default funding lock and
  // echoes the client refund lock unchanged.
  if (envelope.claimant_lock !== bru.getVar("PROVIDER_FUNDING_LOCK")) {
    throw new Error(`claimant_lock must be the provider funding lock script: ${envelope.claimant_lock}`);
  }
  if (envelope.refund_lock !== bru.getVar("REFUND_LOCK")) {
    throw new Error(`refund_lock must echo the client refund lock: ${envelope.refund_lock}`);
  }
  if (envelope.client_invoice !== bru.getVar("CLIENT_INVOICE")) {
    throw new Error(`quote must carry the client invoice: ${envelope.client_invoice}`);
  }

  bru.setVar("QUOTE_ID", envelope.quote_id);
  bru.setVar("QUOTE_AMOUNT", envelope.amount);
  bru.setVar("QUOTE_PROVIDER_FEE", envelope.provider_fee);
  bru.setVar(
    "QUOTE_GROSS_ONCHAIN",
    "0x" + (BigInt(envelope.amount) + BigInt(envelope.provider_fee)).toString(16),
  );
  bru.setVar("QUOTE_ENVELOPE_JSON", JSON.stringify(envelope));
  console.log("loop in quote:", envelope.quote_id, "gross on-chain:", bru.getVar("QUOTE_GROSS_ONCHAIN"));
}
