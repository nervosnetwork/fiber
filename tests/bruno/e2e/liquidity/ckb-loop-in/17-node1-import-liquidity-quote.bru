meta {
  name: node1 import liquidity quote
  type: http
  seq: 17
}

post {
  url: {{NODE1_RPC_URL}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "id": "42",
    "jsonrpc": "2.0",
    "method": "import_liquidity_quote",
    "params": [
      {
        "quote": {{QUOTE_ENVELOPE_JSON}},
        "max_provider_fee": "{{MAX_PROVIDER_FEE_HEX}}",
        "max_routing_fee": "{{MAX_ROUTING_FEE_HEX}}"
      }
    ]
  }
}

assert {
  res.body.error: isUndefined
}

script:post-response {
  const envelope = res.body.result;
  if (!envelope || envelope.quote_id !== bru.getVar("QUOTE_ID")) {
    throw new Error(`import_liquidity_quote must echo quote_id ${bru.getVar("QUOTE_ID")}: ${JSON.stringify(res.body)}`);
  }
  if (envelope.claimant_lock !== bru.getVar("PROVIDER_FUNDING_LOCK")) {
    throw new Error(`imported claimant_lock must be preserved: ${envelope.claimant_lock}`);
  }
  if (envelope.refund_lock !== bru.getVar("REFUND_LOCK")) {
    throw new Error(`imported refund_lock must be preserved: ${envelope.refund_lock}`);
  }
  if (envelope.amount !== bru.getVar("QUOTE_AMOUNT") || envelope.provider_fee !== bru.getVar("QUOTE_PROVIDER_FEE")) {
    throw new Error(`imported amounts must be preserved: ${JSON.stringify(envelope)}`);
  }
  if (envelope.client_invoice !== bru.getVar("CLIENT_INVOICE")) {
    throw new Error(`imported client_invoice must be preserved: ${envelope.client_invoice}`);
  }
  if (envelope.payment_hash !== bru.getVar("PAYMENT_HASH")) {
    throw new Error(`imported payment_hash must be preserved: ${envelope.payment_hash}`);
  }
}
