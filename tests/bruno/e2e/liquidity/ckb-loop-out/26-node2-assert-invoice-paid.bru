meta {
  name: node2 assert invoice paid
  type: http
  seq: 26
}

post {
  url: {{NODE2_RPC_URL}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "id": "42",
    "jsonrpc": "2.0",
    "method": "get_invoice",
    "params": [
      {
        "payment_hash": "{{PAYMENT_HASH}}"
      }
    ]
  }
}

assert {
  res.body.error: isUndefined
}

script:post-response {
  const result = res.body.result;
  if (!result || !result.invoice) {
    throw new Error(`provider invoice for ${bru.getVar("PAYMENT_HASH")} not found: ${JSON.stringify(res.body)}`);
  }
  if (result.status !== "Paid") {
    throw new Error(`provider invoice must be Paid, got: ${result.status}`);
  }
  if (result.invoice.amount !== "0x" + bru.getVar("QUOTE_PRINCIPAL")) {
    throw new Error(`provider invoice amount must equal the principal: ${result.invoice.amount}`);
  }
  if (result.invoice.data.payment_hash !== bru.getVar("PAYMENT_HASH")) {
    throw new Error(`provider invoice payment_hash mismatch: ${result.invoice.data.payment_hash}`);
  }
}
