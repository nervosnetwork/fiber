meta {
  name: node1 import liquidity quote
  type: http
  seq: 13
}

post {
  url: {{NODE1_RPC_URL}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "id": "42",
    "jsonrpc": "2.0",
    "method": "import_liquidity_quote",
    "params": [
      {
        "quote": {{QUOTE_ENVELOPE_JSON}},
        "max_provider_fee": "0xa",
        "max_routing_fee": "0x64"
      }
    ]
  }
}

assert {
  res.body.error: isUndefined
}

script:post-response {
  const envelope = res.body.result;
  if (!envelope || envelope.quote_id !== bru.getVar("QUOTE_ID")) {
    throw new Error(`import_liquidity_quote must echo quote_id ${bru.getVar("QUOTE_ID")}: ${JSON.stringify(res.body)}`);
  }
  if (envelope.claimant_lock !== bru.getVar("CLAIMANT_LOCK")) {
    throw new Error(`imported claimant_lock must be preserved: ${envelope.claimant_lock}`);
  }
  if (envelope.refund_lock !== bru.getVar("QUOTE_REFUND_LOCK")) {
    throw new Error(`imported refund_lock must be preserved: ${envelope.refund_lock}`);
  }
  if (envelope.amount !== "0x3e8" || envelope.provider_fee !== "0x1") {
    throw new Error(`imported amounts must be preserved: ${JSON.stringify(envelope)}`);
  }
}
