meta {
  name: connect node1 to node2
  type: http
  seq: 01
}

post {
  url: {{NODE1_RPC_URL}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "id": "42",
    "jsonrpc": "2.0",
    "method": "connect_peer",
    "params": [
      {
        "address": "{{NODE2_ADDR}}"
      }
    ]
  }
}

script:pre-request {
  // Single source for the swap amount and client fee caps consumed by the
  // invoice (07), quote (12), import (13), execute (14) and gated-accept
  // (25) requests. 0x3e8 is 1000 simple UDT atoms; the lock cell data
  // carries the gross amount (amount + provider fee = 0x3e9).
  bru.setVar("SWAP_AMOUNT_HEX", "0x3e8");
  bru.setVar("MAX_PROVIDER_FEE_HEX", "0xa");
  bru.setVar("MAX_ROUTING_FEE_HEX", "0x64");
}

script:post-response {
  if (res.body.error && !String(res.body.error.message).includes("Peer already connected")) {
    throw new Error(`connect_peer failed: ${res.body.error.message}`);
  }

  // Dialing a peer is async in tentacle. Sleep for some time to make sure
  // we're connected to the peer.
  await new Promise((r) => setTimeout(r, 1000));
}
