meta {
  name: node2 disable liquidity provider mode with swap in flight
  type: http
  seq: 15
}

post {
  url: {{NODE2_RPC_URL}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "id": "42",
    "jsonrpc": "2.0",
    "method": "set_liquidity_provider_mode",
    "params": [
      {
        "enabled": false
      }
    ]
  }
}

assert {
  res.body.error: isUndefined
}

script:post-response {
  // The provider is disabled while the client loop-in swap sits in
  // OnchainLockPending with a broadcast-but-unconfirmed lock cell: exactly
  // the non-terminal state the recovery assertions below exercise.
  if (res.body.result.enabled !== false) {
    throw new Error(`provider mode must be disabled, got: ${JSON.stringify(res.body.result)}`);
  }
}
