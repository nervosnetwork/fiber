meta {
  name: node1 assert invoice paid
  type: http
  seq: 38
}

post {
  url: {{NODE1_RPC_URL}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "id": "42",
    "jsonrpc": "2.0",
    "method": "get_invoice",
    "params": [
      {
        "payment_hash": "{{PAYMENT_HASH}}"
      }
    ]
  }
}

assert {
  res.body.error: isUndefined
}

script:post-response {
  const result = res.body.result;
  if (!result || !result.invoice) {
    throw new Error(`client invoice for ${bru.getVar("PAYMENT_HASH")} not found: ${JSON.stringify(res.body)}`);
  }
  if (result.status !== "Paid") {
    throw new Error(`client invoice must be Paid after the provider payment settles, got: ${result.status}`);
  }
  // The invoice is issued for the raw swap amount; the provider fee is
  // charged on-chain via the lock cell, not through the channel payment.
  if (result.invoice.amount !== bru.getVar("QUOTE_AMOUNT")) {
    throw new Error(`client invoice amount must equal the swap amount: ${result.invoice.amount}`);
  }
  if (result.invoice.data.payment_hash !== bru.getVar("PAYMENT_HASH")) {
    throw new Error(`client invoice payment_hash mismatch: ${result.invoice.data.payment_hash}`);
  }
}
