meta {
  name: ckb generate blocks to confirm loop in lock while disabled
  type: http
  seq: 23
}

post {
  url: {{CKB_RPC_URL}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "id": 42,
    "jsonrpc": "2.0",
    "method": "generate_epochs",
    "params": ["0x2"]
  }
}

assert {
  res.status: eq 200
}

script:post-response {
  // Mining happens with provider mode disabled: the client lock watcher runs
  // on the chain tracer, not behind the provider mode gate, so the swap must
  // advance in request 24 purely from the confirmation.
  await new Promise((r) => setTimeout(r, 5000));
}
