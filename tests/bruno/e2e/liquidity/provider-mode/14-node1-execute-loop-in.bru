meta {
  name: node1 execute loop in before provider mode is disabled
  type: http
  seq: 14
}

post {
  url: {{NODE1_RPC_URL}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "id": "42",
    "jsonrpc": "2.0",
    "method": "loop_in",
    "params": [
      {
        "quote_id": "{{QUOTE_ID}}",
        "funding_tx": "local-wallet"
      }
    ]
  }
}

assert {
  res.body.error: isUndefined
}

script:post-response {
  const { rpc } = require(process.cwd() + "/scripts/wait-liquidity-state");

  // The client funds the liquidity-lock cell from its local wallet and
  // broadcasts the lock transaction. The swap is persisted on the client in
  // OnchainLockPending and the lock confirmation watcher is armed; the lock
  // cell is NOT mined yet, so the state stays pending until request 23.
  const response = res.body.result;
  if (!response || response.swap_id !== bru.getVar("QUOTE_ID")) {
    throw new Error(`client loop_in swap_id must equal the quote_id: ${JSON.stringify(res.body)}`);
  }
  if (response.state !== "OnchainLockPending") {
    throw new Error(`client loop_in must start in OnchainLockPending, got: ${response.state}`);
  }
  if (response.payment_hash !== bru.getVar("PAYMENT_HASH")) {
    throw new Error(`client loop_in payment_hash mismatch: ${response.payment_hash}`);
  }
  if (response.payout_outpoint !== undefined) {
    throw new Error(`client loop_in must not return a payout_outpoint: ${JSON.stringify(response.payout_outpoint)}`);
  }

  // The provider (node2) must not hold any swap record for the quote yet:
  // the provider accept has not run, so the recovery assertion in request 24
  // can attribute the swap advancement purely to the client-side watcher.
  const providerSwap = await rpc(
    bru.getEnvVar("NODE2_RPC_URL"),
    "get_swap",
    [{ swap_id: bru.getVar("QUOTE_ID") }],
  );
  if (providerSwap.result !== null && providerSwap.result !== undefined) {
    throw new Error(`provider must not hold a swap record before the accept: ${JSON.stringify(providerSwap.result)}`);
  }
}
