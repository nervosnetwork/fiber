meta {
  name: node2 enable liquidity provider mode again
  type: http
  seq: 26
}

post {
  url: {{NODE2_RPC_URL}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "id": "42",
    "jsonrpc": "2.0",
    "method": "set_liquidity_provider_mode",
    "params": [
      {
        "enabled": true
      }
    ]
  }
}

assert {
  res.body.error: isUndefined
}

script:post-response {
  // Re-enabling must restore the provider endpoints; the in-flight client
  // swap was never touched by the mode switch.
  if (res.body.result.enabled !== true) {
    throw new Error(`provider mode must be enabled, got: ${JSON.stringify(res.body.result)}`);
  }
}
