meta {
  name: node2 disable liquidity provider mode
  type: http
  seq: 1
}

post {
  url: {{NODE2_RPC_URL}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "id": "42",
    "jsonrpc": "2.0",
    "method": "set_liquidity_provider_mode",
    "params": [
      {
        "enabled": false
      }
    ]
  }
}

assert {
  res.body.error: isUndefined
}

script:post-response {
  // The suite always starts from a disabled provider so the rejection matrix
  // below is deterministic regardless of the state left by earlier suites or
  // runs; the final request re-enables the provider.
  if (res.body.result.enabled !== false) {
    throw new Error(`provider mode must be disabled, got: ${JSON.stringify(res.body.result)}`);
  }
}
