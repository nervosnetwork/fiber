meta {
  name: provider swap and payout record survive the restart
  type: http
  seq: 2
}

post {
  url: {{NODE2_RPC_URL}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "id": "42",
    "jsonrpc": "2.0",
    "method": "get_swap",
    "params": [
      {
        "swap_id": "{{SWAP_ID}}"
      }
    ]
  }
}

assert {
  res.body.error: isUndefined
}

script:post-response {
  const { rpc } = require(process.cwd() + "/scripts/wait-liquidity-state");

  const swap = res.body.result;
  if (!swap) {
    throw new Error(`provider swap ${bru.getVar("SWAP_ID")} not found after the restart`);
  }
  if (swap.state !== "payout_pending") {
    throw new Error(`provider swap must resume in payout_pending before the payout is mined, got: ${swap.state}`);
  }
  if (swap.payment_hash !== bru.getVar("PAYMENT_HASH")) {
    throw new Error(`provider payment_hash must match the client: ${swap.payment_hash} != ${bru.getVar("PAYMENT_HASH")}`);
  }

  // The payout broadcast record persisted by provider_accept_loop_out in
  // phase 1 must come back through the restarted process unchanged: same
  // transaction, same outpoint, still in the broadcast state because phase 2
  // has not mined anything yet.
  const transactions = await rpc(bru.getEnvVar("NODE2_RPC_URL"), "list_liquidity_chain_transactions", [
    { swap_id: bru.getVar("SWAP_ID") },
  ]);
  const payouts = (transactions.result.transactions || []).filter((tx) => tx.role === "payout");
  if (payouts.length !== 1) {
    throw new Error(`restarted provider must hold exactly one payout record, got: ${payouts.length}`);
  }
  const injectedTxHash = bru.getEnvVar("RESTART_PAYOUT_TX_HASH");
  if (injectedTxHash && payouts[0].tx_hash !== injectedTxHash) {
    throw new Error(`provider payout tx_hash must match the phase-1 handoff: ${payouts[0].tx_hash} != ${injectedTxHash}`);
  }
  if (payouts[0].status !== "broadcast") {
    throw new Error(`provider payout record must still be broadcast before mining, got: ${payouts[0].status}`);
  }

  bru.setVar("PAYOUT_TX_HASH", payouts[0].tx_hash);
  console.log("restarted provider payout record:", payouts[0].status, payouts[0].tx_hash);
}
