meta {
  name: ckb generate blocks to confirm the claim
  type: http
  seq: 8
}

post {
  url: {{CKB_RPC_URL}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "id": 42,
    "jsonrpc": "2.0",
    "method": "generate_epochs",
    "params": ["0x2"]
  }
}

assert {
  res.status: eq 200
}

script:post-response {
  // Confirming the client claim lets the restarted provider's claim tracer
  // observe the payout cell spend and drive the swap to success.
  await new Promise((r) => setTimeout(r, 5000));
}
