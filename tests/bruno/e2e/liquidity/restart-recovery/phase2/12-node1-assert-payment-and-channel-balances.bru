meta {
  name: node1 assert payment success and channel balances
  type: http
  seq: 12
}

post {
  url: {{NODE1_RPC_URL}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "id": "42",
    "jsonrpc": "2.0",
    "method": "get_payment",
    "params": [
      {
        "payment_hash": "{{PAYMENT_HASH}}"
      }
    ]
  }
}

assert {
  res.body.error: isUndefined
}

script:post-response {
  const { rpc } = require(process.cwd() + "/scripts/wait-liquidity-state");

  const payment = res.body.result;
  if (!payment) {
    throw new Error(`client payment record for ${bru.getVar("PAYMENT_HASH")} not found`);
  }
  if (payment.payment_hash !== bru.getVar("PAYMENT_HASH")) {
    throw new Error(`payment_hash mismatch: ${payment.payment_hash}`);
  }
  if (payment.status !== "Success") {
    throw new Error(`loop out payment must be Success, got: ${payment.status}`);
  }
  if (typeof payment.payment_preimage !== "string" || payment.payment_preimage.length !== 66) {
    throw new Error(`settled payment must expose the revealed preimage: ${JSON.stringify(payment)}`);
  }

  // The provider invoice amount is the payment principal (quote amount plus
  // provider fee); routing fees are zero on the direct channel.
  const invoice = await rpc(bru.getEnvVar("NODE2_RPC_URL"), "get_invoice", [
    { payment_hash: bru.getVar("PAYMENT_HASH") },
  ]);
  const principal = invoice.result && invoice.result.invoice && invoice.result.invoice.amount;
  if (!principal) {
    throw new Error(`provider invoice for ${bru.getVar("PAYMENT_HASH")} carries no amount: ${JSON.stringify(invoice.result)}`);
  }
  bru.setVar("INVOICE_PRINCIPAL", principal);

  // The pre-restart channel balances are handed over by the supervisor; the
  // only channel mutation since then is the single payment of the principal.
  const localBefore = bru.getEnvVar("RESTART_CLIENT_LOCAL_BEFORE");
  const remoteBefore = bru.getEnvVar("RESTART_CLIENT_REMOTE_BEFORE");
  if (!localBefore || !remoteBefore) {
    console.log("no phase-1 channel balance baseline injected; skipping the delta assertion");
    return;
  }
  const channels = await rpc(bru.getEnvVar("NODE1_RPC_URL"), "list_channels", [{}]);
  const channel = (channels.result.channels || []).find(
    (item) => item.channel_id === bru.getVar("CHANNEL_ID"),
  );
  if (!channel) {
    throw new Error(`channel ${bru.getVar("CHANNEL_ID")} not found on node1`);
  }
  const expectedLocal = BigInt(localBefore) - BigInt(principal);
  const expectedRemote = BigInt(remoteBefore) + BigInt(principal);
  if (BigInt(channel.local_balance) !== expectedLocal) {
    throw new Error(`client local_balance must have decreased by exactly the principal: expected ${expectedLocal}, got ${channel.local_balance}`);
  }
  if (BigInt(channel.remote_balance) !== expectedRemote) {
    throw new Error(`client remote_balance must have increased by exactly the principal: expected ${expectedRemote}, got ${channel.remote_balance}`);
  }
  if (channel.offered_tlc_balance !== "0x0" || channel.received_tlc_balance !== "0x0") {
    throw new Error(`client channel must end with no outstanding TLC balances: ${JSON.stringify(channel)}`);
  }
  if (!Array.isArray(channel.pending_tlcs) || channel.pending_tlcs.length !== 0) {
    throw new Error(`client channel must end with no pending TLCs: ${JSON.stringify(channel.pending_tlcs)}`);
  }
}
