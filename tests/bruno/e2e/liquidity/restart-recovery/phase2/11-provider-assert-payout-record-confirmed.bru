meta {
  name: provider assert payout record confirmed and no claim record
  type: http
  seq: 11
}

post {
  url: {{NODE2_RPC_URL}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "id": "42",
    "jsonrpc": "2.0",
    "method": "list_liquidity_chain_transactions",
    "params": [
      {
        "swap_id": "{{SWAP_ID}}"
      }
    ]
  }
}

assert {
  res.body.error: isUndefined
}

script:post-response {
  // This is the core restart assertion: the payout record that was persisted
  // as "broadcast" before the stop is continued by the restarted process and
  // is now confirmed. Recovery must not duplicate the payout record and must
  // not fabricate a claim record - the provider observes the client claim
  // through the outpoint spend tracer instead.
  const decodeOutpoint = (hex) => {
    if (typeof hex !== "string" || !hex.startsWith("0x") || hex.length !== 74) {
      throw new Error(`outpoint must be 36 molecule bytes: ${hex}`);
    }
    const bytes = hex.slice(2).match(/.{2}/g).map((b) => parseInt(b, 16));
    const index = bytes[32] | (bytes[33] << 8) | (bytes[34] << 16) | (bytes[35] << 24);
    return {
      txHash: "0x" + bytes.slice(0, 32).map((b) => b.toString(16).padStart(2, "0")).join(""),
      index,
    };
  };

  const transactions = res.body.result.transactions || [];
  const payouts = transactions.filter((tx) => tx.role === "payout");
  if (payouts.length !== 1) {
    throw new Error(`provider must hold exactly one payout record, got: ${payouts.length}`);
  }
  const payout = payouts[0];
  if (payout.status !== "confirmed") {
    throw new Error(`provider payout record must be confirmed after recovery, got: ${payout.status}`);
  }
  if (payout.tx_hash !== bru.getVar("PAYOUT_TX_HASH")) {
    throw new Error(`provider payout tx_hash mismatch: ${payout.tx_hash}`);
  }
  const payoutOutpoint = decodeOutpoint(payout.outpoint);
  if (payoutOutpoint.txHash !== bru.getVar("PAYOUT_TX_HASH")) {
    throw new Error(`provider payout outpoint tx_hash mismatch: ${payout.outpoint}`);
  }

  const claim = transactions.find((tx) => tx.role === "claim");
  if (claim) {
    throw new Error(`provider must not record a claim transaction: ${JSON.stringify(claim)}`);
  }
  const refund = transactions.find((tx) => tx.role === "refund");
  if (refund) {
    throw new Error(`successful loop out must not record a refund: ${JSON.stringify(refund)}`);
  }
}
