meta {
  name: node2 capture pre-existing channels to node1
  type: http
  seq: 6
}

post {
  url: {{NODE2_RPC_URL}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "id": "42",
    "jsonrpc": "2.0",
    "method": "list_channels",
    "params": [
      {
        "pubkey": "{{NODE1_PUBKEY}}"
      }
    ]
  }
}

assert {
  res.body.error: isUndefined
  res.body.result.channels: isDefined
}

script:post-response {
  // Remember channels that already exist between node2 and node1 so the
  // freshly opened loop-in channel can be identified uniquely on re-runs.
  const existingIds = (res.body.result.channels || []).map((channel) => channel.channel_id);
  bru.setVar("EXISTING_CHANNEL_IDS", JSON.stringify(existingIds));
}
