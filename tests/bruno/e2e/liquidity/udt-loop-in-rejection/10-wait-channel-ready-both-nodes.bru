meta {
  name: wait channel ready on both nodes
  type: http
  seq: 10
}

post {
  url: {{NODE2_RPC_URL}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "id": "42",
    "jsonrpc": "2.0",
    "method": "list_channels",
    "params": [{}]
  }
}

assert {
  res.body.error: isUndefined
  res.body.result.channels: isDefined
}

script:post-response {
  const { waitChannelReady } = require(process.cwd() + "/scripts/wait-channel-ready");

  await waitChannelReady({
    bru,
    rpcUrls: ["NODE1_RPC_URL", "NODE2_RPC_URL"],
    channelIdVar: "CHANNEL_ID",
    maxAttempts: 120,
    intervalMs: 1000,
  });
}
