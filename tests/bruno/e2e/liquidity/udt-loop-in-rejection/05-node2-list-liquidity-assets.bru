meta {
  name: node2 list liquidity assets
  type: http
  seq: 5
}

post {
  url: {{NODE2_RPC_URL}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "id": "42",
    "jsonrpc": "2.0",
    "method": "list_liquidity_assets",
    "params": []
  }
}

assert {
  res.body.error: isUndefined
}

script:post-response {
  const expectedScript = JSON.parse(bru.getEnvVar("SIMPLE_UDT_TYPE_SCRIPT"));

  const expectedAssetId = bru.getEnvVar("LIQUIDITY_SIMPLE_UDT_ASSET_ID");
  const assets = res.body.result.assets || [];
  const udtAsset = assets.find((asset) => asset.asset_id === expectedAssetId);
  if (!udtAsset) {
    throw new Error(`udt asset ${expectedAssetId} missing from provider registry: ${JSON.stringify(assets)}`);
  }
  if (udtAsset.enabled !== true) {
    throw new Error(`udt asset must be enabled: ${JSON.stringify(udtAsset)}`);
  }
  if (udtAsset.kind !== "udt") {
    throw new Error(`unexpected udt asset kind: ${JSON.stringify(udtAsset)}`);
  }
  if (!udtAsset.udt_type_script
    || udtAsset.udt_type_script.code_hash !== expectedScript.code_hash
    || udtAsset.udt_type_script.hash_type !== expectedScript.hash_type
    || udtAsset.udt_type_script.args !== expectedScript.args) {
    throw new Error(`udt asset must carry the generated simple UDT type script: ${JSON.stringify(udtAsset.udt_type_script)}`);
  }
  // The registry must cover the loop-in swap gross amount (amount + provider
  // fee): the lock cell data carries that gross UDT amount.
  const amount = BigInt(bru.getVar("SWAP_AMOUNT_HEX"));
  const expectedProviderFee =
    BigInt(udtAsset.base_fee) + (amount * BigInt(udtAsset.proportional_fee_ppm)) / BigInt(1000000);
  const gross = amount + expectedProviderFee;
  if (BigInt(udtAsset.max_amount) < gross || BigInt(udtAsset.available_capacity) < gross) {
    throw new Error(`udt asset capacity must cover the loop in swap gross 0x${gross.toString(16)}: ${JSON.stringify(udtAsset)}`);
  }

  // Propagate the registry fee parameters so the quote assertion derives its
  // expected provider fee from the registry response instead of duplicated
  // constants.
  bru.setVar("REGISTRY_BASE_FEE", udtAsset.base_fee);
  bru.setVar("REGISTRY_FEE_PPM", udtAsset.proportional_fee_ppm);
}
