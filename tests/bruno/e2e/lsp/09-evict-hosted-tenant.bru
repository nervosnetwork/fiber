meta {
  name: evict hosted tenant
  type: http
  seq: 9
}

post {
  url: {{NODE2_RPC_URL}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
  Authorization: Bearer {{LSP_OPERATOR_TOKEN}}
}

body:json {
  {
    "id": "42",
    "jsonrpc": "2.0",
    "method": "lsp_evict_tenant",
    "params": [
      { "tenant_id": "placeholder" }
    ]
  }
}

script:pre-request {
  const body = req.getBody();
  body.params[0].tenant_id = bru.getVar("LSP_TENANT_ID");
  req.setBody(body);
}

assert {
  res.body.error: isUndefined
  res.body.result.runtime_status: eq "cold"
  res.body.result.channel_online: eq false
}

script:post-response {
  if (res.body.result.private_channel_id !== bru.getVar("HOSTED_CHANNEL_ID")) {
    throw new Error("eviction did not preserve the hosted private channel binding");
  }
  await new Promise(r => setTimeout(r, 500));
}
