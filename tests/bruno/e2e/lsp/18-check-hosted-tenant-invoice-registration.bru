meta {
  name: Public T automatically registered hosted tenant invoice
  type: http
  seq: 18
}

post {
  url: {{NODE2_RPC_URL}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
  Authorization: Bearer {{LSP_OPERATOR_TOKEN}}
}

body:json {
  {
    "id": "42",
    "jsonrpc": "2.0",
    "method": "lsp_get_invoice_registration",
    "params": [
      {
        "payment_hash": "{{LSP_INCOMING_PAYMENT_HASH}}"
      }
    ]
  }
}

assert {
  res.body.error: isUndefined
  res.body.result.tenant_id: eq "u1"
  res.body.result.invoice: eq "{{LSP_INCOMING_INVOICE}}"
  res.body.result.hint.lsp_node_id: eq "{{NODE2_PUBKEY}}"
}

script:post-response {
  if (res.body.result.hint.payment_hash !== bru.getVar("LSP_INCOMING_PAYMENT_HASH")) {
    throw new Error("automatically registered LSP hint must match the tenant invoice payment hash");
  }
}
