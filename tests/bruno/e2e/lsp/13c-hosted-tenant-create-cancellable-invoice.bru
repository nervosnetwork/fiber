meta {
  name: hosted tenant creates a throwaway invoice to cancel
  type: http
  seq: 13.6
}

post {
  url: {{NODE2_RPC_URL}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
  Authorization: Bearer {{LSP_TENANT_TOKEN}}
}

body:json {
  {
    "id": "42",
    "jsonrpc": "2.0",
    "method": "new_invoice",
    "params": [
      {
        "amount": "0xf4240",
        "currency": "Fibd",
        "description": "hosted tenant invoice to cancel",
        "expiry": "0xe10",
        "allow_trampoline_routing": true,
        "final_expiry_delta": "0x5265c00",
        "payment_hash": "0xcccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc"
      }
    ]
  }
}

assert {
  res.body.error: isUndefined
  res.body.result.invoice.data.payment_hash: isDefined
}

script:post-response {
  bru.setVar("LSP_CANCEL_PAYMENT_HASH", res.body.result.invoice.data.payment_hash);
}
