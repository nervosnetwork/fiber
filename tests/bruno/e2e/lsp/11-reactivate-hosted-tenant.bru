meta {
  name: reactivate hosted tenant
  type: http
  seq: 11
}

post {
  url: {{NODE2_RPC_URL}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "id": "42",
    "jsonrpc": "2.0",
    "method": "lsp_ensure_tenant",
    "params": [
      { "tenant_id": "u1" }
    ]
  }
}

assert {
  res.body.error: isUndefined
  res.body.result.runtime_status: eq "active"
}

script:post-response {
  if (res.body.result.invoice_pubkey !== bru.getVar("HOSTED_TENANT_PUBKEY")) {
    throw new Error("hosted tenant identity changed after reactivation");
  }
}
