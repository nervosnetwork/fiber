meta {
  name: Node1 pays offline hosted tenant through Public T
  type: http
  seq: 20
}

post {
  url: {{NODE1_RPC_URL}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "id": "42",
    "jsonrpc": "2.0",
    "method": "send_payment",
    "params": [
      {
        "invoice": "{{LSP_INCOMING_INVOICE}}",
        "max_fee_amount": "0x2710"
      }
    ]
  }
}

assert {
  res.body.error: isUndefined
  res.body.result.payment_hash: eq "{{LSP_INCOMING_PAYMENT_HASH}}"
}
