meta {
  name: check hosted tenant invoice paid
  type: http
  seq: 26
}

post {
  url: {{NODE2_RPC_URL}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "id": "42",
    "jsonrpc": "2.0",
    "method": "lsp_get_invoice",
    "params": [
      {
        "tenant_id": "u1",
        "payment_hash": "{{LSP_INCOMING_PAYMENT_HASH}}"
      }
    ]
  }
}

assert {
  res.body.error: isUndefined
  res.body.result.status: eq "Paid"
}
