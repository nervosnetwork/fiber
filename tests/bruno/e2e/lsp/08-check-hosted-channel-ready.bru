meta {
  name: check hosted private channel ready
  type: http
  seq: 8
}

post {
  url: {{NODE2_RPC_URL}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "id": "42",
    "jsonrpc": "2.0",
    "method": "list_channels",
    "params": [
      { "pubkey": "{{HOSTED_TENANT_PUBKEY}}" }
    ]
  }
}

vars:post-response {
  HOSTED_READY_MAX_ITERATIONS: 30
}

assert {
  res.body.error: isUndefined
}

script:post-response {
  const channel = (res.body.result.channels || []).find(
    item => item.channel_id === bru.getVar("HOSTED_CHANNEL_ID")
  );
  const iteration = Number(bru.getVar("HOSTED_READY_ITERATION") || 0);
  const maxIterations = Number(bru.getVar("HOSTED_READY_MAX_ITERATIONS"));

  if (channel?.state?.state_name === "ChannelReady") {
    if (channel.is_public !== false) {
      throw new Error(`hosted channel must be private: ${JSON.stringify(channel)}`);
    }
    bru.setVar("HOSTED_READY_ITERATION", 0);
    return;
  }
  if (iteration + 1 < maxIterations) {
    bru.setVar("HOSTED_READY_ITERATION", iteration + 1);
    await new Promise(r => setTimeout(r, 1000));
    bru.setNextRequest("check hosted private channel ready");
    return;
  }
  throw new Error(`hosted channel did not become ready: ${JSON.stringify(channel)}`);
}
