meta {
  name: wait incoming hosted delivery success
  type: http
  seq: 25
}

post {
  url: {{NODE2_RPC_URL}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
  Authorization: Bearer {{LSP_OPERATOR_TOKEN}}
}

body:json {
  {
    "id": "42",
    "jsonrpc": "2.0",
    "method": "lsp_get_payment_delivery",
    "params": [
      { "payment_hash": "{{LSP_INCOMING_PAYMENT_HASH}}" }
    ]
  }
}

vars:post-response {
  LSP_DELIVERY_SUCCESS_MAX_ITERATIONS: 30
}

assert {
  res.body.error: isUndefined
}

script:post-response {
  const delivery = res.body.result;
  const iteration = Number(bru.getVar("LSP_DELIVERY_SUCCESS_ITERATION") || 0);
  const maxIterations = Number(bru.getVar("LSP_DELIVERY_SUCCESS_MAX_ITERATIONS"));

  if (delivery.status === "succeeded") {
    bru.setVar("LSP_DELIVERY_SUCCESS_ITERATION", 0);
    return;
  }
  if (["failed", "cancelled", "expired"].includes(delivery.status)) {
    throw new Error(`hosted delivery failed: ${JSON.stringify(delivery)}`);
  }
  if (iteration + 1 < maxIterations) {
    bru.setVar("LSP_DELIVERY_SUCCESS_ITERATION", iteration + 1);
    await new Promise(r => setTimeout(r, 1000));
    bru.setNextRequest("wait incoming hosted delivery success");
    return;
  }
  throw new Error(`hosted delivery stayed ${delivery.status}`);
}
