meta {
  name: read RootSigner tenant from SDK agent
  type: http
  seq: 2
}

get {
  url: {{LSP_SDK_AGENT_URL}}/status
  body: none
  auth: none
}

vars:post-response {
  AGENT_STATUS_MAX_ITERATIONS: 60
}

script:post-response {
  const iteration = Number(bru.getVar("AGENT_STATUS_ITERATION") || 0);
  const maxIterations = Number(bru.getVar("AGENT_STATUS_MAX_ITERATIONS"));
  if (res.status === 200 && res.body.tenant_token && res.body.tenant_id) {
    console.log("Step 02 registered tenant_id:", res.body.tenant_id);
    console.log("Step 02 registered tenant_token:", res.body.tenant_token);
    bru.setVar("LSP_TENANT_ID", res.body.tenant_id);
    bru.setVar("LSP_TENANT_TOKEN", res.body.tenant_token);
    bru.setVar("REMOTE_ROOT_PUBKEY", res.body.root_signer_pubkey);
    bru.setEnvVar("LSP_TENANT_ID", res.body.tenant_id);
    bru.setEnvVar("LSP_TENANT_TOKEN", res.body.tenant_token);
    bru.setEnvVar("REMOTE_ROOT_PUBKEY", res.body.root_signer_pubkey);
    bru.setVar("AGENT_STATUS_ITERATION", 0);
    return;
  }
  if (iteration + 1 < maxIterations) {
    bru.setVar("AGENT_STATUS_ITERATION", iteration + 1);
    await new Promise(r => setTimeout(r, 1000));
    bru.setNextRequest("read RootSigner tenant from SDK agent");
    return;
  }
  throw new Error(`SDK agent did not become ready: ${JSON.stringify(res.body)}`);
}
