meta {
  name: submit hosted external funding transaction
  type: http
  seq: 5.2
}

post {
  url: {{NODE2_RPC_URL}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{LSP_TENANT_TOKEN}}
}

body:json {
  {"id":"42","jsonrpc":"2.0","method":"submit_signed_funding_tx","params":[{"channel_id":"placeholder","signed_funding_tx":{}}]}
}

script:pre-request {
  const token = bru.getVar("LSP_TENANT_TOKEN") || bru.getEnvVar("LSP_TENANT_TOKEN");
  if (token) {
    req.setHeader("Authorization", `Bearer ${token}`);
  }
  const body = req.getBody();
  body.params[0].channel_id = bru.getVar("HOSTED_CHANNEL_ID");
  body.params[0].signed_funding_tx = bru.getVar("REMOTE_SIGNED_TX");
  req.setBody(body);
}

assert {
  res.body.error: isUndefined
  res.body.result.funding_tx_hash: isDefined
}

script:post-response {
  bru.setVar("HOSTED_FUNDING_TX_HASH", res.body.result.funding_tx_hash);
}
