meta {
  name: wait hosted channel reestablished
  type: http
  seq: 12
}

post {
  url: {{NODE2_RPC_URL}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
  Authorization: Bearer {{LSP_OPERATOR_TOKEN}}
}

body:json {
  {
    "id": "42",
    "jsonrpc": "2.0",
    "method": "lsp_list_tenants"
  }
}

vars:post-response {
  HOSTED_REESTABLISH_MAX_ITERATIONS: 30
}

assert {
  res.body.error: isUndefined
}

script:post-response {
  const tenant = (res.body.result.tenants || []).find(item => item.tenant_id === "u1");
  const iteration = Number(bru.getVar("HOSTED_REESTABLISH_ITERATION") || 0);
  const maxIterations = Number(bru.getVar("HOSTED_REESTABLISH_MAX_ITERATIONS"));

  if (
    tenant?.runtime_status === "active" &&
    tenant.channel_online &&
    tenant.private_channel_id === bru.getVar("HOSTED_CHANNEL_ID")
  ) {
    bru.setVar("HOSTED_REESTABLISH_ITERATION", 0);
    return;
  }
  if (iteration + 1 < maxIterations) {
    bru.setVar("HOSTED_REESTABLISH_ITERATION", iteration + 1);
    await new Promise(r => setTimeout(r, 1000));
    bru.setNextRequest("wait hosted channel reestablished");
    return;
  }
  throw new Error(`hosted channel was not reestablished: ${JSON.stringify(tenant)}`);
}
