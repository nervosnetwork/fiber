meta {
  name: wait hosted funding transaction broadcast
  type: http
  seq: 5.3
}

post {
  url: {{CKB_RPC_URL}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {"id":42,"jsonrpc":"2.0","method":"get_transaction","params":["placeholder"]}
}

script:pre-request {
  const body = req.getBody();
  body.params[0] = bru.getVar("HOSTED_FUNDING_TX_HASH");
  req.setBody(body);
}

assert {
  res.body.error: isUndefined
}

script:post-response {
  const status = res.body.result?.tx_status?.status;
  if (["pending", "proposed", "committed"].includes(status)) {
    bru.setVar("HOSTED_FUNDING_BROADCAST_ITERATION", 0);
    return;
  }
  if (status === "rejected") {
    throw new Error(`hosted funding transaction rejected: ${JSON.stringify(res.body.result.tx_status)}`);
  }
  const iteration = Number(bru.getVar("HOSTED_FUNDING_BROADCAST_ITERATION") || 0);
  if (iteration + 1 < 30) {
    bru.setVar("HOSTED_FUNDING_BROADCAST_ITERATION", iteration + 1);
    await new Promise(r => setTimeout(r, 1000));
    bru.setNextRequest("wait hosted funding transaction broadcast");
    return;
  }
  throw new Error(`hosted funding transaction was not broadcast: ${JSON.stringify(res.body)}`);
}
