meta {
  name: activate hosted tenant
  type: http
  seq: 3
}

post {
  url: {{NODE2_RPC_URL}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
  Authorization: Bearer {{LSP_OPERATOR_TOKEN}}
}

body:json {
  {
    "id": "42",
    "jsonrpc": "2.0",
    "method": "lsp_ensure_tenant",
    "params": [
      { "tenant_id": "placeholder" }
    ]
  }
}

script:pre-request {
  const body = req.getBody();
  body.params[0].tenant_id = bru.getVar("LSP_TENANT_ID");
  req.setBody(body);
}

assert {
  res.body.error: isUndefined
  res.body.result.runtime_status: eq "active"
  res.body.result.channel_online: eq false
}

script:post-response {
  if (res.body.result.tenant_id !== bru.getVar("LSP_TENANT_ID")) {
    throw new Error("activated tenant id does not match the registered RootSigner tenant");
  }
  bru.setVar("HOSTED_TENANT_PUBKEY", res.body.result.invoice_pubkey);
}
