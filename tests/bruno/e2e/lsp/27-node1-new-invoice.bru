meta {
  name: create Node1 invoice for hosted tenant payment
  type: http
  seq: 27
}

post {
  url: {{NODE1_RPC_URL}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "id": "42",
    "jsonrpc": "2.0",
    "method": "new_invoice",
    "params": [
      {
        "amount": "0x186a0",
        "currency": "Fibd",
        "description": "hosted tenant outgoing payment",
        "expiry": "0xe10",
        "allow_trampoline_routing": true
      }
    ]
  }
}

assert {
  res.body.error: isUndefined
  res.body.result.invoice_address: isDefined
}

script:post-response {
  bru.setVar("LSP_OUTGOING_INVOICE", res.body.result.invoice_address);
  bru.setVar("LSP_OUTGOING_PAYMENT_HASH", res.body.result.invoice.data.payment_hash);
}
