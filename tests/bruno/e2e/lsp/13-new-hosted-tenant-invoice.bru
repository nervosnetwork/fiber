meta {
  name: hosted tenant creates invoice through standard RPC
  type: http
  seq: 13
}

post {
  url: {{NODE2_RPC_URL}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
  Authorization: Bearer {{LSP_OPERATOR_TOKEN}}
}

body:json {
  {
    "id": "42",
    "jsonrpc": "2.0",
    "method": "lsp_new_invoice",
    "params": [
      {
        "tenant_id": "placeholder",
        "invoice": {
          "amount": "0xf4240",
          "currency": "Fibd",
          "description": "hosted tenant incoming payment",
          "expiry": "0xe10",
          "allow_trampoline_routing": true,
          "payment_preimage": "0x2222222222222222222222222222222222222222222222222222222222222222"
        }
      }
    ]
  }
}

script:pre-request {
  const body = req.getBody();
  body.params[0].tenant_id = bru.getVar("LSP_TENANT_ID");
  req.setBody(body);
}

assert {
  res.body.error: isUndefined
  res.body.result.invoice: isDefined
  res.body.result.hint.payment_hash: isDefined
}

script:post-response {
  if (res.body.result.hint.lsp_node_id !== bru.getEnvVar("NODE2_PUBKEY")) {
    throw new Error("hosted invoice must advertise Public T as its trampoline route hint");
  }
  bru.setVar("LSP_INCOMING_INVOICE", res.body.result.invoice);
  bru.setVar("LSP_INCOMING_PAYMENT_HASH", res.body.result.hint.payment_hash);
}
