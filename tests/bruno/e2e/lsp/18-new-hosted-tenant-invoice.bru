meta {
  name: create hosted tenant invoice
  type: http
  seq: 18
}

post {
  url: {{NODE2_RPC_URL}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "id": "42",
    "jsonrpc": "2.0",
    "method": "lsp_new_invoice",
    "params": [
      {
        "tenant_id": "u1",
        "invoice": {
          "amount": "0xf4240",
          "currency": "Fibd",
          "description": "hosted tenant incoming payment",
          "expiry": "0xe10",
          "allow_trampoline_routing": true
        },
        "buffer_duration_ms": "0xea60"
      }
    ]
  }
}

assert {
  res.body.error: isUndefined
  res.body.result.tenant_id: eq "u1"
  res.body.result.invoice: isDefined
  res.body.result.hint.lsp_node_id: eq "{{NODE2_PUBKEY}}"
}

script:post-response {
  bru.setVar("LSP_INCOMING_INVOICE", res.body.result.invoice);
  bru.setVar("LSP_INCOMING_PAYMENT_HASH", res.body.result.hint.payment_hash);
}
