meta {
  name: check Node1 received hosted tenant payment
  type: http
  seq: 30
}

post {
  url: {{NODE1_RPC_URL}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "id": "42",
    "jsonrpc": "2.0",
    "method": "get_invoice",
    "params": [
      { "payment_hash": "{{LSP_OUTGOING_PAYMENT_HASH}}" }
    ]
  }
}

script:pre-request {
  const body = req.getBody();
  body.params[0].payment_hash = bru.getVar("LSP_OUTGOING_PAYMENT_HASH");
  req.setBody(body);
}

assert {
  res.body.error: isUndefined
  res.body.result.status: eq "Paid"
}
