meta {
  name: Public T registers hosted tenant invoice
  type: http
  seq: 18
}

post {
  url: {{NODE2_RPC_URL}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
  Authorization: Bearer {{LSP_OPERATOR_TOKEN}}
}

body:json {
  {
    "id": "42",
    "jsonrpc": "2.0",
    "method": "lsp_register_invoice",
    "params": [
      {
        "tenant_id": "u1",
        "invoice": "{{LSP_INCOMING_INVOICE}}",
        "buffer_duration_ms": "0xea60"
      }
    ]
  }
}

assert {
  res.body.error: isUndefined
  res.body.result.tenant_id: eq "u1"
  res.body.result.invoice: isDefined
  res.body.result.hint.lsp_node_id: eq "{{NODE2_PUBKEY}}"
}

script:post-response {
  if (res.body.result.hint.payment_hash !== bru.getVar("LSP_INCOMING_PAYMENT_HASH")) {
    throw new Error("registered LSP hint must match the tenant invoice payment hash");
  }
}
