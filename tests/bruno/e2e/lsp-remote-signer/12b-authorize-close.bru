meta {
  name: authorize Close
  type: http
  seq: 12.5
}

post {
  url: {{LSP_SDK_AGENT_URL}}/authorize
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {"type":"Close","channel_id":"placeholder","local_script":{},"remote_script":{},"local_fee_rate":1000,"remote_fee_rate":0}
}

script:pre-request {
  const body = req.getBody();
  body.channel_id = bru.getVar("REMOTE_CHANNEL_ID");
  body.local_script = bru.getVar("REMOTE_FUNDING_SCRIPT");
  body.remote_script = bru.getVar("REMOTE_PEER_SHUTDOWN_SCRIPT");
  req.setBody(body);
}

assert {
  res.status: eq 200
  res.body.result.authorized: eq true
}
