meta {
  name: create hosted invoice after signer restart
  type: http
  seq: 12
}

post {
  url: {{NODE2_RPC_URL}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{REMOTE_TENANT_TOKEN}}
}

body:json {
  {"id":"42","jsonrpc":"2.0","method":"new_invoice","params":[{"amount":"0x186a0","currency":"Fibd","description":"remote signer restart E2E","expiry":"0xe10","payment_hash":"0x1111111111111111111111111111111111111111111111111111111111111111"}]}
}

assert {
  res.body.error: isUndefined
  res.body.result.invoice_address: isDefined
}
