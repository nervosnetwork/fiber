meta {
  name: create hosted invoice after signer restart
  type: http
  seq: 12
}

post {
  url: {{NODE2_RPC_URL}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{LSP_OPERATOR_TOKEN}}
}

body:json {
  {
    "id": "42",
    "jsonrpc": "2.0",
    "method": "lsp_new_invoice",
    "params": [
      {
        "tenant_id": "placeholder",
        "invoice": {
          "amount": "0x186a0",
          "currency": "Fibd",
          "description": "remote signer restart E2E",
          "expiry": "0xe10",
          "payment_hash": "0x1111111111111111111111111111111111111111111111111111111111111111"
        }
      }
    ]
  }
}

script:pre-request {
  const body = req.getBody();
  body.params[0].tenant_id = bru.getVar("REMOTE_TENANT_ID");
  req.setBody(body);
}

assert {
  res.body.error: isUndefined
  res.body.result.invoice: isDefined
}
