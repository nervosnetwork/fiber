meta {
  name: verify restarted signer completed cooperative close
  type: http
  seq: 15
}

post {
  url: {{NODE2_RPC_URL}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{REMOTE_TENANT_TOKEN}}
}

body:json {
  {"id":"42","jsonrpc":"2.0","method":"list_channels","params":[{"include_closed":true}]}
}

vars:post-response {
  REMOTE_CLOSED_MAX_ITERATIONS: 60
}

script:post-response {
  if (res.body.error) throw new Error(res.body.error.message);
  const channel = (res.body.result.channels || []).find(item => item.channel_id === bru.getVar("REMOTE_CHANNEL_ID"));
  const iteration = Number(bru.getVar("REMOTE_CLOSED_ITERATION") || 0);
  if (channel?.state?.state_name === "Closed") return;
  if (iteration + 1 < Number(bru.getVar("REMOTE_CLOSED_MAX_ITERATIONS"))) {
    bru.setVar("REMOTE_CLOSED_ITERATION", iteration + 1);
    await new Promise(r => setTimeout(r, 1000));
    bru.setNextRequest("verify restarted signer completed cooperative close");
    return;
  }
  throw new Error(`restarted signer did not complete close: ${JSON.stringify(channel)}`);
}
