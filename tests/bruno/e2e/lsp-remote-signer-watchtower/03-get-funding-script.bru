meta {
  name: get external funding wallet script
  type: http
  seq: 3
}

post {
  url: {{NODE1_RPC_URL}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {"id":"42","jsonrpc":"2.0","method":"node_info","params":[]}
}

assert {
  res.body.error: isUndefined
  res.body.result.default_funding_lock_script: isDefined
}

script:post-response {
  bru.setVar("REMOTE_FUNDING_SCRIPT", res.body.result.default_funding_lock_script);
}
