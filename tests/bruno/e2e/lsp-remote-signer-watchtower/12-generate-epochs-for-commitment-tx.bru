meta {
  name: generate epochs for force-close commitment tx
  type: http
  seq: 12
}

post {
  url: {{CKB_RPC_URL}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {"id":42,"jsonrpc":"2.0","method":"generate_epochs","params":["0x1"]}
}

assert {
  res.status: eq 200
}

script:post-response {
  await new Promise(r => setTimeout(r, 5000));
}
