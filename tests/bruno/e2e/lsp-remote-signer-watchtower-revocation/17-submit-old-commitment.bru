meta {
  name: Public T submits an old version commitment tx
  type: http
  seq: 17
}

post {
  url: {{NODE2_RPC_URL}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{REMOTE_TENANT_TOKEN}}
}

body:json {
  {
    "id": "42",
    "jsonrpc": "2.0",
    "method": "submit_commitment_transaction",
    "params": [
      {
        "channel_id": "placeholder",
        "commitment_number": "0x1"
      }
    ]
  }
}

script:pre-request {
  const body = req.getBody();
  body.params[0].channel_id = bru.getVar("REMOTE_CHANNEL_ID");
  req.setBody(body);
}

assert {
  res.body.error: isUndefined
  res.body.result.tx_hash: isDefined
}

script:post-response {
  bru.setVar("TX_HASH", res.body.result.tx_hash);
}
