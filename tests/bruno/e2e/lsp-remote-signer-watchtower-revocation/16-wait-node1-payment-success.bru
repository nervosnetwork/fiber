meta {
  name: wait Node1 hosted payment success
  type: http
  seq: 16
}

post {
  url: {{NODE1_RPC_URL}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "id": "42",
    "jsonrpc": "2.0",
    "method": "get_payment",
    "params": [
      { "payment_hash": "{{LSP_INCOMING_PAYMENT_HASH}}" }
    ]
  }
}

script:pre-request {
  const body = req.getBody();
  body.params[0].payment_hash = bru.getVar("LSP_INCOMING_PAYMENT_HASH");
  req.setBody(body);
}

vars:post-response {
  LSP_INCOMING_PAYMENT_MAX_ITERATIONS: 60
}

assert {
  res.body.error: isUndefined
}

script:post-response {
  const payment = res.body.result;
  const iteration = Number(bru.getVar("LSP_INCOMING_PAYMENT_ITERATION") || 0);
  const maxIterations = Number(bru.getVar("LSP_INCOMING_PAYMENT_MAX_ITERATIONS"));

  if (payment.status === "Success") {
    bru.setVar("LSP_INCOMING_PAYMENT_ITERATION", 0);
    return;
  }
  if (payment.status === "Failed") {
    throw new Error(`payer failed to reach hosted tenant: ${payment.failed_error}`);
  }
  if (iteration + 1 < maxIterations) {
    bru.setVar("LSP_INCOMING_PAYMENT_ITERATION", iteration + 1);
    await new Promise(r => setTimeout(r, 1000));
    bru.setNextRequest("wait Node1 hosted payment success");
    return;
  }
  throw new Error(`payer stayed ${payment.status}`);
}
