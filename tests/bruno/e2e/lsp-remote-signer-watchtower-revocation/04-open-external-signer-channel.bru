meta {
  name: open hosted channel with SDK signer
  type: http
  seq: 4
}

post {
  url: {{LSP_SDK_AGENT_URL}}/open-channel
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "params":{
      "pubkey":"{{NODE2_PUBKEY}}","public":false,
      "funding_amount":"0xba43b7400","commitment_fee_rate":"0x3e8","commitment_delay_epoch":"0x10000000001",
      "shutdown_script":{},"funding_lock_script":{},"external_channel_signer":{}
    }
  }
}

script:pre-request {
  const body = req.getBody();
  body.params.shutdown_script = bru.getVar("REMOTE_FUNDING_SCRIPT");
  body.params.funding_lock_script = bru.getVar("REMOTE_FUNDING_SCRIPT");
  body.params.external_channel_signer = bru.getVar("REMOTE_OPEN_MATERIAL");
  req.setBody(body);
}

assert {
  res.body.error: isUndefined
  res.body.result.channel_id: isDefined
  res.body.result.unsigned_funding_tx: isDefined
}

script:post-response {
  if (res.body.error) throw new Error(JSON.stringify(res.body.error));
  bru.setVar("REMOTE_CHANNEL_ID", res.body.result.channel_id);
  bru.setEnvVar("REMOTE_CHANNEL_ID", res.body.result.channel_id);
  bru.setVar("REMOTE_UNSIGNED_TX", res.body.result.unsigned_funding_tx);
  bru.setEnvVar("REMOTE_UNSIGNED_TX", res.body.result.unsigned_funding_tx);
}
