meta {
  name: evict hosted tenant before force-close
  type: http
  seq: 10
}

post {
  url: {{NODE2_RPC_URL}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{LSP_OPERATOR_TOKEN}}
}

body:json {
  {"id":"42","jsonrpc":"2.0","method":"lsp_evict_tenant","params":[{"tenant_id":"placeholder"}]}
}

script:pre-request {
  const body = req.getBody();
  body.params[0].tenant_id = bru.getVar("REMOTE_TENANT_ID");
  req.setBody(body);
}

assert {
  res.body.error: isUndefined
  res.body.result.runtime_status: eq "cold"
}

script:post-response {
  const channel = (res.body.result.channels || []).find(
    item => item.channel_id === bru.getVar("REMOTE_CHANNEL_ID")
  );
  if (!channel) {
    throw new Error("eviction did not preserve the hosted channel binding");
  }
  if (channel.online) {
    throw new Error("eviction left the hosted channel online");
  }
  await new Promise(r => setTimeout(r, 500));
}
